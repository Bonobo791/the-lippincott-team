# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Tooling / agent output
.playwright-mcp
.playwright-cli
.playwright
.impeccable
.prototools

# Design-fidelity audit artifacts (Plan 5 / concept-to-launch) — not committed
.launch

# TinaCMS generated output (also covered by tina/.gitignore)
tina/__generated__

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Yarn Integrity file
.yarn-integrity

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Package Manager Lock Files (pnpm-lock.yaml IS committed — it's what makes
# Netlify/CI detect pnpm instead of falling back to npm)
package-lock.json
yarn.lock
.yarn/cache
bun.lockb
deno.lock

# Cached WordPress source data (one-off migration pipeline)
scripts/migrate/data/

# builds
.vercel
.netlify
.wrangler
dist
.serena
.idea
.claude
.astro