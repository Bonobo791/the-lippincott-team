---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import StandaloneBody from '../components/standalone/StandaloneBody.astro';
import { getConfig, getStandalone } from '../lib/data';
import { islands } from '../lib/islands';
import { hasRichText, richTextToPlainText } from '../lib/rich-text';
import { telHref } from '../lib/url';
// Shared "Verified Record" (.home-v2) design system — also used by buy/sell.
import '../styles/v2.css';

const result = await getStandalone('home');
const data = result.data?.standalone;
if (!data || data.__typename !== 'StandaloneHome') return new Response('Not Found', { status: 404 });
const config = (await getConfig()).data?.config ?? null;

const phone = config?.contact?.phone ?? null;
const email = data.finalCta?.email?.trim() ? data.finalCta.email : (config?.contact?.email ?? null);
const agent = data.agentSchema;
const faqItems = (data.faq?.items ?? []).filter((q) => q !== null).filter((q) => q.question?.trim() && hasRichText(q.answer));
const jsonld = [
	agent && {
		'@context': 'https://schema.org',
		'@type': 'RealEstateAgent',
		name: config?.seo?.title ?? undefined,
		description: agent.description ?? undefined,
		url: Astro.site?.href,
		...(phone ? { telephone: telHref(phone)?.replace(/^tel:/, '') } : {}),
		...(email ? { email } : {}),
		...(config?.seo?.brandSubtitle
			? { parentOrganization: { '@type': 'Organization', name: config.seo.brandSubtitle } }
			: {}),
		areaServed: (agent.areasServed ?? [])
			.filter((a) => a !== null)
			.map((a) => ({ '@type': a.kind ?? 'Place', name: a.name })),
		...(agent.award ? { award: agent.award } : {}),
		...(agent.rating
			? {
					aggregateRating: {
						'@type': 'AggregateRating',
						ratingValue: agent.rating,
						bestRating: '5',
						reviewCount: agent.reviewCount ?? undefined,
					},
				}
			: {}),
	},
	faqItems.length > 0 && {
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((q) => ({
			'@type': 'Question',
			name: q.question,
			acceptedAnswer: { '@type': 'Answer', text: richTextToPlainText(q.answer) },
		})),
	},
].filter(Boolean);
---

<Base
	title={data.seoTitle || config?.seo?.title || 'The Lippincott Team'}
	description={data.description?.trim() || config?.seo?.description || ''}
	image={data.socialImage ?? undefined}
>
	{/* The hero video's poster is the LCP image — discover it from the HTML head
	    instead of waiting for the <video> element to be parsed. */}
	{data.hero?.poster && <link slot="head" rel="preload" as="image" href={data.hero.poster} fetchpriority="high" />}
	{jsonld.map((entry) => <script type="application/ld+json" is:inline set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />)}

	<TinaIsland name="standalone" wrapper={islands.standalone.wrapper} params={{ slug: 'home' }} primary>
		<StandaloneBody data={data} />
	</TinaIsland>

	<script is:inline data-astro-rerun>
	// Bound once: astro:page-load fires on first load, ClientRouter swaps, and
	// the island-reinit dispatch after a Tina edit swaps the island's DOM.
	if (!window.__homeMotionBound) {
		window.__homeMotionBound = true;
		document.addEventListener('astro:page-load', function initHomeMotion() {
		var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// count-up helper
		function countUp(el, target, opts) {
			var prefix = (opts && opts.prefix) || '', suffix = (opts && opts.suffix) || '', dur = (opts && opts.dur) || 1200;
			if (!el.firstChild) return;
			if (reduced) { el.firstChild.textContent = prefix + target.toLocaleString() + suffix; return; }
			var t0 = performance.now();
			(function tick(t) {
				var p = Math.min((t - t0) / dur, 1);
				var e = 1 - Math.pow(1 - p, 3);
				if (el.firstChild) el.firstChild.textContent = prefix + Math.round(e * target).toLocaleString() + suffix;
				if (p < 1) requestAnimationFrame(tick);
			})(t0);
		}

		// awards numeral — target and suffix come from the CMS-driven data attrs.
		var awardDone = false;
		function awardCount() {
			if (awardDone) return; awardDone = true;
			var el = document.getElementById('awardCount');
			if (!el) return;
			var target = +(el.dataset.count || 0), sfx = el.dataset.suffix || '';
			if (reduced) { el.textContent = target + sfx; return; }
			var t0 = performance.now();
			(function tick(t) {
				var p = Math.min((t - t0) / 1100, 1);
				var e = 1 - Math.pow(1 - p, 3);
				el.textContent = Math.round(e * target) + sfx;
				if (p < 1) requestAnimationFrame(tick);
			})(t0);
		}

		// reveal on scroll + triggers
		var statsDone = new WeakSet();
		var awardEl = document.getElementById('awardCount');
		var io = new IntersectionObserver(function (entries) {
			entries.forEach(function (en) {
				if (!en.isIntersecting) return;
				var el = en.target;
				el.classList.add('in');
				if (awardEl && el.contains(awardEl)) awardCount();
				el.querySelectorAll('.num[data-count]').forEach(function (n) {
					if (statsDone.has(n)) return; statsDone.add(n);
					countUp(n, +n.dataset.count, { prefix: n.dataset.prefix || '', suffix: n.dataset.suffix || '' });
				});
				io.unobserve(el);
			});
		}, { threshold: 0.2 });
		document.querySelectorAll('.home-v2 .reveal').forEach(function (el) { io.observe(el); });

		// fail-safe: never leave above-fold content hidden
		setTimeout(function () {
			document.querySelectorAll('.home-v2 .reveal:not(.in)').forEach(function (el) {
				if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in');
			});
		}, 1600);
		});
	}
	</script>
</Base>
