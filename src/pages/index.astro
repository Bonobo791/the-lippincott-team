---
import Base from '../layouts/Base.astro';
---

<Base
	title="Northwest Houston Realtors | The Lippincott Team, 9× HBJ Award Winners"
	description="The Lippincott Team helps Northwest Houston sellers price, stage and sell, and buyers find the right home. 1,463+ sold, rated 4.9. Free consultation."
	image="/uploads/2026/03/header-houston.jpeg"
>
	<script type="application/ld+json" is:inline>
	{
	  "@context": "https://schema.org",
	  "@type": "RealEstateAgent",
	  "name": "The Lippincott Team",
	  "description": "Residential real estate team with eXp Realty serving Northwest Houston: Cypress, Tomball, Katy, Bridgeland, Towne Lake, Magnolia, Waller and Hockley.",
	  "url": "https://lippincottteam.com/",
	  "telephone": "+1-713-494-1818",
	  "email": "info@lippincottteam.com",
	  "parentOrganization": {"@type": "Organization", "name": "eXp Realty"},
	  "areaServed": [
	    {"@type": "City", "name": "Cypress, TX"},
	    {"@type": "City", "name": "Tomball, TX"},
	    {"@type": "City", "name": "Katy, TX"},
	    {"@type": "City", "name": "Bridgeland, TX"},
	    {"@type": "City", "name": "Towne Lake, TX"},
	    {"@type": "City", "name": "Magnolia, TX"},
	    {"@type": "City", "name": "Waller, TX"},
	    {"@type": "City", "name": "Hockley, TX"}
	  ],
	  "award": "Houston Business Journal Residential Real Estate Award (2017-2025), GHBA Prism Award Realtor of the Year, eXp Icon Award",
	  "aggregateRating": {"@type": "AggregateRating", "ratingValue": "4.9", "bestRating": "5", "reviewCount": "750"}
	}
	</script>
	<script type="application/ld+json" is:inline>
	{
	  "@context": "https://schema.org",
	  "@type": "FAQPage",
	  "mainEntity": [
	    {"@type": "Question", "name": "What areas does the Lippincott Team serve?",
	     "acceptedAnswer": {"@type": "Answer", "text": "Cypress, Tomball, Katy, Bridgeland, Towne Lake, Magnolia, Waller and Hockley: the greater Northwest Houston market, from first showing to final signature."}},
	    {"@type": "Question", "name": "How much is my home worth in Cypress, TX?",
	     "acceptedAnswer": {"@type": "Answer", "text": "Cypress's median listing price was $435,535 in May 2026 (Realtor.com). Your value depends on subdivision, condition and recent comparable sales. Request a free data-backed valuation."}},
	    {"@type": "Question", "name": "How long does it take to sell a home in Cypress?",
	     "acceptedAnswer": {"@type": "Answer", "text": "The Cypress median was 35 days on market in May 2026; Houston overall averaged 52 days in June 2026. Accurately priced, well-presented homes sell fastest."}},
	    {"@type": "Question", "name": "Do I need a realtor to buy new construction in Bridgeland?",
	     "acceptedAnswer": {"@type": "Answer", "text": "The builder's rep works for the builder. A buyer's agent costs you nothing out of pocket and negotiates incentives, upgrades and inspection terms on your side."}},
	    {"@type": "Question", "name": "Why choose the Lippincott Team over other Northwest Houston realtors?",
	     "acceptedAnswer": {"@type": "Answer", "text": "Nine verified HBJ awards (2017-2025), 1,463+ homes sold, and 750+ five-star reviews at 4.9 on Google and HAR.com. Documented results, not claims."}}
	  ]
	}
	</script>

	<div class="home-v2">
		<!-- ============ HERO ============ -->
		<section class="hero">
			<video autoplay muted loop playsinline poster="/uploads/2026/03/header-houston.jpeg">
				<source src="https://lippincottteam.com/wp-content/uploads/2026/06/Lippincott-Hero-no-pool.mp4" type="video/mp4" />
			</video>
			<div class="hero-inner">
				<span class="kicker">#1 Team in Northwest Houston</span>
				<h1>The team that sells <em>Northwest Houston.</em></h1>
				<p>1,463+ homes sold. 750+ five-star reviews. Nine Houston Business Journal awards, every one verified against MLS data, not voted on.</p>
				<div class="hero-actions">
					<a class="btn" href="/contact-us/">Schedule a Consultation</a>
					<a class="text-link" href="https://www.thelippincottteam.com/property-search/results/">or browse live listings →</a>
				</div>
			</div>
		</section>

		<!-- ============ ANSWER CAPSULE (machine-readable only, visually hidden) ============ -->
		<div class="capsule" aria-hidden="true">
			<div class="capsule-inner">
				<p><strong>Quick answer:</strong> The Lippincott Team is a residential real estate team with eXp Realty serving Northwest Houston: Cypress, Tomball, Katy, Bridgeland, Towne Lake, Magnolia, Waller and Hockley. The team reports 1,463+ homes sold and 750+ five-star reviews across Google and HAR.com, and has won the Houston Business Journal's Residential Real Estate Award nine times, 2017 through 2025. Phone: <a href="tel:7134941818" tabindex="-1" style="font-weight:600;color:var(--ink)">713-494-1818</a>.</p>
			</div>
		</div>

