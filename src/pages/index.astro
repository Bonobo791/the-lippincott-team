						<video controls muted playsinline preload="metadata" poster="/uploads/2026/03/testimonial-poster.jpg">
							<source src="https://lippincottteam.com/wp-content/uploads/2026/03/testimonial_Edwards_v1_horizontal.mp4.mp4" type="video/mp4" />
