---
import Base from '../layouts/Base.astro';
import V2Motion from '../components/v2/V2Motion.astro';
import { Icon } from 'astro-icon/components';
import { getConfig } from '../lib/data';
import { telHref } from '../lib/url';
import '../styles/v2.css';

const phone = (await getConfig()).data?.config?.contact?.phone;

// Curated from the live HAR.com survey feed (member 586048) — the same
// comments the widget above renders. Kept static so the carousel works with
// or without the third-party widget, and each quote cites its survey.
const featuredReviews = [
	{ quote: 'Ashley Walters was absolutely wonderful to work with throughout the sale of my home. She was professional, knowledgeable, responsive, and made the entire process feel smooth and stress-free. Ashley was always available to answer questions, kept me informed every step of the way, and truly had my best interests in mind.', src: 'Verified HAR.com survey · Talley Valley Dr, July 2026' },
	{ quote: 'They stage it well and then our home sold in one weekend. We have now bought and sold 3 homes with the Lippincott Team, they are truly the best in the business.', src: 'Verified HAR.com survey' },
	{ quote: 'I highly recommend The Lippincott Team, especially J-R Satchel, for anyone looking to rent, buy, or sell a home in the Cypress and Bridgeland area. J-R did an excellent job helping us rent our home in Bridgeland very quickly — within just two weeks.', src: 'Verified HAR.com survey · Blooming Shrubs Ct, July 2026' },
	{ quote: "Amy's team was wonderful in every way. All our expectations were exceeded.", src: 'Verified client review · Lismore Lake Dr, Cypress' },
	{ quote: 'Brooke was fantastic. She found the perfect home for me and my family, she was there for me every step of the way and it was such a seamless process. I have already referred friends to her.', src: 'Verified HAR.com survey · Blue Catfish Ln, June 2026' },
	{ quote: 'Amiee was very helpful as well as knowledgeable. We are so thankful that she was our realtor!', src: 'Verified client review · Maple Meadows Dr' },
	{ quote: 'Brenner has always been awesome. Best customer service and knowledge.', src: 'Verified HAR.com survey · Meadow Blossom Ln, June 2026' },
	{ quote: 'Amy and her team are the best. We will be recommending her to all our friends needing a smooth and professional real estate experience.', src: 'Verified HAR.com survey · First Landing Dr, June 2026' },
	{ quote: 'Jennipher is very professional and knowledgeable. She went above and beyond to make the sale of this house as stress free as possible.', src: 'Verified HAR.com survey · Red Sage Ct, May 2026' },
	{ quote: 'Stacy Hooper is a stellar person to work with. I would use her again in a heartbeat.', src: 'Verified HAR.com survey · Skyline Arbor Ter, May 2026' },
	{ quote: 'Had a fantastic experience with Amy and her team. Jennipher helped find us the perfect house that met all of our needs.', src: 'Verified HAR.com survey · Ocean Onyx Dr, March 2026' },
	{ quote: 'I have been using this agency for around 10 years and would not trust anyone else with my properties.', src: 'Verified HAR.com survey · Pine Falls Dr, July 2026' },
];
const jsonld = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'RealEstateAgent',
			name: 'The Lippincott Team',
			...(phone ? { telephone: telHref(phone)?.replace(/^tel:/, '') } : {}),
			areaServed: ['Cypress TX', 'Tomball TX', 'Katy TX', 'Magnolia TX', 'Waller TX', 'Hockley TX', 'Bridgeland TX', 'Towne Lake TX', 'Elyson TX', 'Fairfield TX', 'Coles Crossing TX'],
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: '4.9',
				reviewCount: '750',
			},
		},
		{
			'@type': 'FAQPage',
			mainEntity: [
				{ '@type': 'Question', name: 'Where do these reviews come from?', acceptedAnswer: { '@type': 'Answer', text: 'Two places we do not control. The feed on this page loads directly from our public HAR.com profile, where clients complete surveys after closing: 687+ completed surveys averaging 4.92 out of 5.' } },
				{ '@type': 'Question', name: 'Can I read every review, unedited?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The HAR.com feed shows surveys as clients complete them, and the full survey history is public on HAR.com.' } },
				{ '@type': 'Question', name: 'How do I leave a review?', acceptedAnswer: { '@type': 'Answer', text: 'After closing, your transaction coordinator sends both links. Google reviews post straight to our public profile, and HAR.com surveys go to clients of record. Every review counts the same, glowing or not.' } },
			],
		},
	],
};
---

<Base
	title="Client Reviews: 750+ Five-Star Ratings | The Lippincott Team"
	description="750+ five-star reviews across Google and HAR.com: 4.9 on Google, 4.92 out of 5 across 687+ client surveys. Read them unedited, live from HAR.com."
	image="/uploads/2026/03/header-houston.jpeg"
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

	<div class="home-v2">
		<!-- ============ PAGE HEAD ============ -->
		<section class="band">
			<div class="wrap">
				<span class="eyebrow red reveal">Client reviews</span>
				<h1 class="display reveal">Reviewed, <em>in public.</em></h1>
				<p class="lede reveal">More than 750 five-star reviews across Google and HAR.com, 687+ of them completed client surveys averaging 4.92 out of 5.</p>
			</div>
		</section>

		<!-- ============ THE RECORD ============ -->
		<section class="band ink dark">
			<div class="wrap">
				<span class="eyebrow gold reveal">The record</span>
				<h2 class="display sec reveal">Four numbers, <em>no adjectives.</em></h2>
				<div class="dgrid four spaced reveal">
					<div class="dtile">
						<span class="num">4.9</span>
						<span class="slabel">On Google</span>
						<span class="ssrc">Across 200+ reviews</span>
					</div>
					<div class="dtile">
						<a href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener"><span class="num gold">4.92</span></a>
						<span class="slabel">Out of 5 on HAR.com</span>
						<span class="ssrc">687+ completed client surveys</span>
					</div>
					<div class="dtile">
						<a href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener"><span class="num" data-count="750">0<span>+</span></span></a>
						<span class="slabel">Five-star reviews</span>
						<span class="ssrc">Google and HAR.com combined</span>
					</div>
					<div class="dtile">
						<span class="num" data-count="1463">0<span>+</span></span>
						<span class="slabel">Homes sold</span>
						<span class="ssrc">Team sales records, Northwest Houston</span>
					</div>
				</div>
				<p class="sec-cta gold reveal"><a class="link-arrow" href="/about/">Meet the team behind the numbers →</a></p>
			</div>
		</section>

		<!-- ============ FEATURED REVIEWS CAROUSEL ============ -->
		<section class="band ink dark">
			<div class="wrap">
				<span class="eyebrow gold reveal">Featured reviews</span>
				<h2 class="display sec reveal">Fresh from the <em>survey line.</em></h2>
				<p class="lede reveal">Clients say it best — here is what the last few months of completed surveys look like, rotating automatically. Pause on hover, or click through.</p>
				<div class="carousel reveal" data-reviews-carousel aria-roledescription="carousel" aria-label="Featured client reviews">
					<div class="car-viewport">
						<div class="car-track" data-car-track>
							{featuredReviews.map((review, i) => (
								<figure class="car-slide" data-car-slide aria-hidden={i !== 0}>
									<blockquote>&ldquo;{review.quote}&rdquo;</blockquote>
									<figcaption>
										<span class="stars" aria-hidden="true">★★★★★</span>
										{review.src}
									</figcaption>
								</figure>
							))}
						</div>
					</div>
					<button type="button" class="car-arrow prev" data-car-prev aria-label="Previous review">&#8592;</button>
					<button type="button" class="car-arrow next" data-car-next aria-label="Next review">&#8594;</button>
					<div class="car-dots" data-car-dots aria-label="Choose review"></div>
				</div>
				<p class="sec-cta gold reveal"><a class="link-arrow" href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener">Read all 687 surveys on HAR.com →</a></p>
			</div>
		</section>

		<!-- ============ LIVE HAR.COM FEED ============ -->
		<section class="band">
			<div class="wrap">
				<span class="eyebrow red reveal">HAR.com reviews</span>
				<h2 class="display sec reveal">Straight from <em>HAR.com.</em></h2>
				<p class="lede reveal">A live feed from our public HAR.com profile. New surveys appear here as clients complete them, unedited and uncurated.</p>
					<div class="feed reveal">
						<div id="har-feed" class="har-widget" aria-live="polite">
							<script is:inline>
								(() => {
									const normalizeMarkup = (markup) => String(markup).replace(
										/((?:src|href)=["']|url\(["']?)\/Realtor-Agent-Rating\//gi,
										'$1https://members.har.com/Realtor-Agent-Rating/',
									);
									window.__harWidgetOriginalWrite = document.write;
									window.__harWidgetOriginalWriteln = document.writeln;
									document.write = (markup) => window.__harWidgetOriginalWrite.call(document, normalizeMarkup(markup));
									document.writeln = (markup) => window.__harWidgetOriginalWriteln.call(document, normalizeMarkup(markup));
								})();
							</script>
							<script
								is:inline
								src="https://members.har.com/realtor-agent-rating/api/default.cfm?member_number=586048&bg=e8e3d9&showcat=y&showcomments=y"
						></script>
					</div>
						<script is:inline>
							(() => {
								const profileUrl = 'https://www.har.com/amy-lippincott/ratings_586048';
								if (window.__harWidgetOriginalWrite) {
									document.write = window.__harWidgetOriginalWrite;
									document.writeln = window.__harWidgetOriginalWriteln;
									delete window.__harWidgetOriginalWrite;
									delete window.__harWidgetOriginalWriteln;
								}
								document.querySelectorAll('#har-feed a[href*="/Realtor-Agent-Rating/"]').forEach((link) => {
									link.setAttribute('href', profileUrl);
									link.setAttribute('target', '_blank');
									link.setAttribute('rel', 'noopener');
								});
							})();
					</script>
					<p class="feed-note">Read every survey on <a href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener">HAR.com →</a></p>
				</div>
				<p class="sec-cta reveal"><a class="link-arrow" href="/about/">Meet the team behind the reviews →</a></p>
			</div>
		</section>

		<!-- ============ VERIFICATION ============ -->
		<section class="band ivory">
			<div class="wrap">
				<span class="eyebrow red reveal">Verification</span>
				<h2 class="display sec reveal">Check us <em>anywhere.</em></h2>
				<p class="lede reveal">Do not take this page's word for it. The same numbers are posted in places we cannot touch.</p>
				<div class="jobs three reveal" style="margin-top:48px">
					<div class="job">
						<span class="tag red">HAR.com</span>
						<h3>687+ surveys, in the open</h3>
						<p>Every completed client survey posts to our public HAR.com profile: <a href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener">687+ surveys averaging 4.92 out of 5</a>, with the written comments attached.</p>
						<a class="link-arrow" href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener">Read the surveys →</a>
					</div>
					<div class="job">
						<span class="tag red">Google</span>
						<h3>200+ reviews on the profile</h3>
						<p>The Google Business Profile carries the same record: 4.9 stars across more than 200 reviews, posted by clients in their own names.</p>
						<a class="link-arrow" href="https://www.google.com/search?q=The+Lippincott+Team+eXp+Realty+Cypress+reviews" target="_blank" rel="noopener">See the Google profile →</a>
					</div>
					<div class="job">
						<span class="tag red">Houston Business Journal</span>
						<h3>Nine years of awards</h3>
						<p>Nine-time HBJ Residential Real Estate Award winner, 2017 through 2025, verified against MLS production data, not nominations.</p>
					</div>
				</div>
				<div class="social-row reveal">
					<span class="social-label">Follow the team</span>
					<div class="social-btns">
						<a class="social-btn" href="https://www.facebook.com/realestatewithamy" target="_blank" rel="noopener"><Icon name="tabler:brand-facebook" size={18} /><span>Facebook</span></a>
						<a class="social-btn" href="https://www.instagram.com/the_lippincott-team_cypress" target="_blank" rel="noopener"><Icon name="tabler:brand-instagram" size={18} /><span>Instagram</span></a>
						<a class="social-btn" href="https://www.youtube.com/@realestatewithamy" target="_blank" rel="noopener"><Icon name="tabler:brand-youtube" size={18} /><span>YouTube</span></a>
						<a class="social-btn" href="https://www.twitter.com/amylippincott" target="_blank" rel="noopener"><Icon name="tabler:brand-x" size={18} /><span>X / Twitter</span></a>
						<a class="social-btn" href="https://www.linkedin.com/company/4802854" target="_blank" rel="noopener"><Icon name="tabler:brand-linkedin" size={18} /><span>LinkedIn</span></a>
					</div>
				</div>
				<p class="sec-cta reveal"><a class="link-arrow" href="/contact-us/">Put the record behind your move →</a></p>
			</div>
		</section>

		<!-- ============ FAQ ============ -->
		<section class="faq">
			<div class="wrap">
				<h2 class="display sec reveal">Reviews, <em>answered.</em></h2>
				<div class="faq-list">
					<details class="reveal">
						<summary>Where do these reviews come from? <span class="plus">+</span></summary>
						<p>Two places we do not control. The feed above loads directly from our public HAR.com profile, where clients complete surveys after closing: <a href="https://www.har.com/amy-lippincott/ratings_586048" target="_blank" rel="noopener">687+ completed surveys averaging 4.92 out of 5</a>. Google reviews post to our public Business Profile.</p>
					</details>
					<details class="reveal">
						<summary>Can I read every review, unedited? <span class="plus">+</span></summary>
						<p>Yes. The HAR.com feed shows surveys as clients complete them, and the full survey history is public on HAR.com, which is the entire point of reading them.</p>
					</details>
					<details class="reveal">
						<summary>How do I leave a review? <span class="plus">+</span></summary>
						<p>After closing, your transaction coordinator sends both links. Google reviews post straight to our public profile, and HAR.com surveys go to clients of record. Every review counts the same, glowing or not.</p>
					</details>
				</div>
				<p class="sec-cta reveal"><a class="link-arrow" href="/contact-us/">Ask us your question →</a></p>
			</div>
		</section>

		<!-- ============ FINAL CTA ============ -->
		<section class="final dark">
			<div class="reveal">
				<h2>Experience what the <em>reviews describe.</em></h2>
				<p>A consultation with the team behind 750+ five-star reviews on Google and HAR.com. Free, and the advice is yours to keep.</p>
				<div class="final-actions">
					<a class="btn" href="/contact-us/">Schedule a Consultation →</a>
					{phone && <a class="text-link" href={telHref(phone)}>Call {phone} →</a>}
				</div>
			</div>
		</section>
	</div>

	<script>
		// Auto-rotating featured-reviews carousel. Static slides in the DOM;
		// this only manages which slide is visible. Auto-advance pauses on
		// hover/focus and never runs under prefers-reduced-motion.
		(() => {
			const root = document.querySelector('[data-reviews-carousel]');
			if (!root) return;
			const slides = Array.from(root.querySelectorAll('[data-car-slide]'));
			if (slides.length < 2) return;
			const track = root.querySelector('[data-car-track]');
			const dotsWrap = root.querySelector('[data-car-dots]');
			const prev = root.querySelector('[data-car-prev]');
			const next = root.querySelector('[data-car-next]');
			let current = 0;
			let timer = 0;
			const INTERVAL = 6000;

			const dots = slides.map((_, i) => {
				const dot = document.createElement('button');
				dot.type = 'button';
				dot.className = 'car-dot';
				dot.setAttribute('aria-label', `Review ${i + 1} of ${slides.length}`);
				dot.addEventListener('click', () => { go(i); restart(); });
				dotsWrap.appendChild(dot);
				return dot;
			});

			const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			function go(i) {
				current = (i + slides.length) % slides.length;
				slides.forEach((slide, idx) => {
					slide.classList.toggle('is-active', idx === current);
					slide.setAttribute('aria-hidden', String(idx !== current));
				});
				dots.forEach((dot, idx) => {
					dot.classList.toggle('is-active', idx === current);
					if (idx === current) dot.setAttribute('aria-current', 'true');
					else dot.removeAttribute('aria-current');
				});
				track.style.transform = `translateX(-${current * 100}%)`;
			}

			function restart() {
				if (reduced()) return;
				window.clearInterval(timer);
				timer = window.setInterval(() => go(current + 1), INTERVAL);
			}
			function stop() {
				window.clearInterval(timer);
			}

			prev.addEventListener('click', () => { go(current - 1); restart(); });
			next.addEventListener('click', () => { go(current + 1); restart(); });
			root.addEventListener('mouseenter', stop);
			root.addEventListener('mouseleave', restart);
			root.addEventListener('focusin', stop);
			root.addEventListener('focusout', restart);
			// Keyboard: left/right to move between reviews when focused.
			root.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') { go(current - 1); restart(); }
				if (e.key === 'ArrowRight') { go(current + 1); restart(); }
			});

			// ClientRouter swaps away from this page keep the autoplay timer
			// alive otherwise (it keeps firing on detached slides and holds the
			// whole carousel closure); tear it down on the next page swap.
			document.addEventListener('astro:before-swap', stop, { once: true });

			go(0);
			restart();
		})();
	</script>

	<V2Motion />
</Base>
