---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Page not found (404)" description="The page you're looking for doesn't exist.">
	<section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-6 text-center">
		<div class="relative flex flex-col items-center">
			<p class="text-sm font-medium tracking-widest text-primary uppercase">Error 404</p>
			<h1 class="mt-2 text-4xl font-semibold tracking-tight lg:text-5xl">Page not found</h1>
			<p class="mx-auto mt-4 max-w-md text-muted-foreground">The page you're looking for doesn't exist. Let's get you back home.</p>
			<Button href="/" class="mt-8">Back to home</Button>
		</div>
	</section>
</Base>
