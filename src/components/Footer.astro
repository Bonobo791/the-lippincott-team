---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig, CmsConfigContactLink, CmsConfigNav, CmsConfigNavChild } from '../lib/data';
import { safeHref } from '../lib/url';
import IconLink from "./IconLink.astro";

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contactLinks = (config?.contactLinks ?? []).filter(
	(item): item is CmsConfigContactLink => item !== null,
);
const isExternal = (href?: string | null) => !!href && /^https?:\/\//.test(href);
const contact = config?.contact ?? null;
const today = new Date();
// CMS-provided URL — only allow http(s)/root-relative before rendering.
const logoSrc = safeHref(seo?.logo);

const childrenOf = (item: CmsConfigNav | null) =>
	(item?.children ?? []).filter((child): child is CmsConfigNavChild => child !== null);
const communitiesNav = nav.find((item) => item.link?.startsWith('/northwest-houston-real-estate')) ?? null;
const schoolsNav = nav.find((item) => item.link?.startsWith('/northwest-houston-schools-real-estate')) ?? null;
const companyNav = nav.filter((item) => ['/buy/', '/sell/', '/about/', '/reviews/', '/blog/', '/contact-us/'].includes(item.link ?? ''));
const neighborhoods = childrenOf(communitiesNav)
	.flatMap((community) => community.children ?? [])
	.filter((neighborhood) => neighborhood !== null);
const columns = [
	{ heading: 'Communities', href: communitiesNav?.link ?? null, links: childrenOf(communitiesNav) },
	{ heading: 'Neighborhoods', href: null, links: neighborhoods },
	{ heading: 'Schools', href: schoolsNav?.link ?? null, links: childrenOf(schoolsNav) },
	{ heading: 'Company', href: null, links: companyNav },
	{
		heading: 'Resources',
		href: null,
		links: [
			{ title: 'Privacy Policy', link: '/privacy-policy/' },
			{ title: 'Terms and Conditions', link: '/terms-and-conditions/' },
		],
	},
].filter((column) => column.links.length > 0);
---

<footer class="font-apple bg-[#100e13] text-sm text-[rgba(246,242,234,0.62)]">
	<div class="mx-auto grid max-w-[1200px] grid-cols-2 gap-10 px-6 pt-[72px] lg:grid-cols-[1.6fr_repeat(5,1fr)]">
		<div class="space-y-4">
			<div class="flex items-center gap-3 text-white">
				{logoSrc ? (
					<img src={logoSrc} alt="" width="34" height="34" class="size-[34px]" />
				) : null}
				<div>
					<p class="text-[15px] font-bold leading-[1.1]">{seo?.title ?? 'The Lippincott Team'}</p>
					<p class="text-[11px] uppercase tracking-[0.18em] text-[rgba(246,242,234,0.62)]">eXp Realty</p>
				</div>
			</div>
			{config?.footerBlurb && (
				<p class="max-w-[38ch] leading-[1.7]" data-tina-field={tinaField(config, "footerBlurb")}>{config.footerBlurb}</p>
			)}
			{contact?.email && (
				<p>
					Contact us at{' '}
					<a href={`mailto:${contact.email}`} class="text-[rgba(246,242,234,0.62)] transition-colors hover:text-white">{contact.email}</a>
				</p>
			)}
			{contactLinks.length > 0 && (
				<div class="flex flex-wrap gap-4">
					{contactLinks.map((link) => (
						<IconLink
							title={link.title}
							link={link.link}
							icon={link.icon}
							class="transition-colors hover:text-white"
							data-tina-field={tinaField(link, "title")}
						/>
					))}
				</div>
			)}
		</div>
		{columns.map((column) => (
			<nav aria-label={`Footer ${column.heading}`}>
				<h2 class="mb-[18px] text-xs font-semibold uppercase tracking-[0.2em] text-white">
					{column.href ? (
						<a href={safeHref(column.href)} class="transition-colors hover:text-white">{column.heading}</a>
					) : (
						column.heading
					)}
				</h2>
				<ul class="flex flex-col gap-[11px]">
					{column.links.map((item) => (
						<li>
							<a
								href={safeHref(item.link)}
								class="transition-colors hover:text-white"
								{...(isExternal(item.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								{item.title}
							</a>
						</li>
					))}
				</ul>
			</nav>
		))}
	</div>
	<div class="mx-auto max-w-[1200px] px-6 pb-10">
		<div class="mt-14 flex flex-col items-center justify-between gap-3.5 border-t border-[rgba(246,242,234,0.12)] pt-[26px] text-[12.5px] sm:flex-row">
			<p>
				&copy; {today.getFullYear()}{' '}
				<span data-tina-field={seo ? tinaField(seo, "siteOwner") : undefined}>{seo?.siteOwner}</span>. All rights reserved.
			</p>
			<p class="flex gap-[22px]">
				<a href="/privacy-policy/" class="transition-colors hover:text-white">Privacy Policy</a>
				<a href="/terms-and-conditions/" class="transition-colors hover:text-white">Terms &amp; Conditions</a>
			</p>
		</div>
	</div>
</footer>
