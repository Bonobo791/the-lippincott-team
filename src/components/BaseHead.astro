---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/logo.webp' } = Astro.props;

// GA4 measurement ID, overridable per environment without a code change.
const gaId = import.meta.env.PUBLIC_GA_ID ?? 'G-ZREVRSHYJB';
// Send hits only from production builds, and on Netlify only from the
// production context (deploy previews/branch deploys build with
// NODE_ENV=production but get CONTEXT=deploy-preview/branch-deploy).
// When CONTEXT is unset (local builds, non-Netlify hosts) PROD alone decides.
const includeAnalytics =
	import.meta.env.PROD &&
	(process.env.CONTEXT === undefined || process.env.CONTEXT === 'production');
---

<!-- Global Metadata -->
<meta charset="utf-8" />

<!-- Google Analytics (GA4) — direct gtag.js snippet, gated on includeAnalytics above. The gtag.js loader runs once; the inline config has data-astro-rerun so ClientRouter navigations re-fire the config call and keep sending pageviews. -->
{
	includeAnalytics && (
		<>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
			<script
				is:inline
				data-astro-rerun
				set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(gaId)});`}
			/>
		</>
	)
}
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Tina Cloud rewrites media URLs to assets.tina.io in production; warm the connection. -->
<link rel="preconnect" href="https://assets.tina.io" crossorigin />
<link rel="dns-prefetch" href="https://assets.tina.io" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- TinaCMS visual editing is wired by the tina() integration in astro.config.mjs; its middleware only touches edit-mode responses, so there's nothing to add here. -->

<ClientRouter />
