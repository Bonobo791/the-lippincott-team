---
import { Icon } from 'astro-icon/components';
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const isExternal = (href?: string | null) => !!href && /^https?:\/\//.test(href);
const externalAttrs = (href?: string | null) =>
	isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<header class="sticky top-0 z-20 w-full border-b bg-background/95 backdrop-blur-xl">
	<div class="bg-foreground text-background">
		<div class="mx-auto flex max-w-6xl items-center justify-end px-6 py-2">
			<a href="tel:+17134941818" class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wider hover:opacity-80">
				<Icon name="tabler:phone" class="size-3.5" />
				<span>713-494-1818</span>
			</a>
		</div>
	</div>
	<nav class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3">
		<a href="/" class="flex shrink-0 items-center">
			{seo?.logo && <img src={seo.logo} alt={seo.title ?? 'Logo'} width="191" height="55" class="h-10 w-auto" data-tina-field={tinaField(seo, "logo")} />}
		</a>
		<div class="hidden items-center gap-6 lg:flex">
			{nav.map((item) => {
				const children = (item.children ?? []).filter(c => c !== null);
				return children.length > 0 ? (
					<div class="group relative" data-tina-field={tinaField(item, "title")}>
						<a
							href={item.link}
							class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-[0.175em] text-foreground/80 transition-colors hover:text-primary"
							{...externalAttrs(item.link)}
						>
							{item.title}
							<Icon name="tabler:chevron-down" class="size-3.5" />
						</a>
						<div class="invisible absolute left-0 top-full z-30 min-w-56 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
							<div class="rounded-md border bg-popover py-2 shadow-lg">
								{children.map((child) => (
									<a
										href={child.link}
										class="block px-4 py-2 text-sm text-popover-foreground/80 transition-colors hover:bg-accent hover:text-foreground"
										{...externalAttrs(child.link)}
									>
										{child.title}
									</a>
								))}
							</div>
						</div>
					</div>
				) : (
					<a
						href={item.link}
						class="text-xs font-semibold uppercase tracking-[0.175em] text-foreground/80 transition-colors hover:text-primary"
						data-tina-field={tinaField(item, "title")}
						{...externalAttrs(item.link)}
					>
						{item.title}
					</a>
				);
			})}
			<ThemeToggle />
		</div>
		<button
			id="mobile-menu-toggle"
			type="button"
			aria-label="Toggle navigation menu"
			aria-controls="mobile-menu-panel"
			aria-expanded="false"
			class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground focus-visible:ring-ring/50 focus-visible:ring-[3px] outline-none lg:hidden"
		>
			<Icon name="tabler:menu-2" class="icon-open size-5" />
			<Icon name="tabler:x" class="icon-close size-5" />
		</button>
	</nav>
	<div
		id="mobile-menu-panel"
		hidden
		class="border-t bg-background/95 backdrop-blur-xl lg:hidden"
	>
		<div class="mx-auto flex max-w-6xl flex-col px-6 py-4">
			{nav.map((item) => {
				const children = (item.children ?? []).filter(c => c !== null);
				return (
					<>
						<a
							href={item.link}
							class="border-b border-border/50 py-3 text-xs font-semibold uppercase tracking-[0.175em] text-foreground/80 transition-colors hover:text-foreground"
							data-tina-field={tinaField(item, "title")}
							{...externalAttrs(item.link)}
						>
							{item.title}
						</a>
						{children.map((child) => (
							<a
								href={child.link}
								class="border-b border-border/50 py-3 pl-4 text-sm text-muted-foreground transition-colors last:border-b-0 hover:text-foreground"
								{...externalAttrs(child.link)}
							>
								{child.title}
							</a>
						))}
					</>
				);
			})}
			<div class="mt-4 flex items-center justify-end pt-2">
				<ThemeToggle />
			</div>
		</div>
	</div>
</header>
<style>
	#mobile-menu-toggle .icon-close { display: none; }
	#mobile-menu-toggle[aria-expanded="true"] .icon-open { display: none; }
	#mobile-menu-toggle[aria-expanded="true"] .icon-close { display: block; }
</style>
<script is:inline>
	if (!window.__mobileMenuBound) {
		window.__mobileMenuBound = true;
		const setOpen = (open) => {
			const btn = document.getElementById('mobile-menu-toggle');
			const panel = document.getElementById('mobile-menu-panel');
			if (!btn || !panel) return;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.hidden = !open;
		};
		document.addEventListener('click', (e) => {
			const toggle = e.target.closest('#mobile-menu-toggle');
			if (toggle) {
				const isOpen = toggle.getAttribute('aria-expanded') === 'true';
				setOpen(!isOpen);
				return;
			}
			if (e.target.closest('#mobile-menu-panel a')) {
				setOpen(false);
			}
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}
</script>
