---
import { Icon } from 'astro-icon/components';
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';
import { safeHref, telHref } from '../lib/url';
import { cn } from '../lib/cn';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contact = config?.contact ?? null;
const isExternal = (href?: string | null) => !!href && /^https?:\/\//.test(href);
const externalAttrs = (href?: string | null) =>
	isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href?: string | null) =>
	!isExternal(href) && ((href ?? '/').replace(/\/+$/, '') || '/') === currentPath;
---

<header class="font-apple sticky top-0 z-20 w-full border-b border-[rgba(246,242,234,0.12)] bg-[rgba(23,21,26,0.82)] backdrop-blur-[14px]">
	<div class="mx-auto flex h-[72px] max-w-[1280px] items-center justify-between gap-6 px-6">
		<a href="/" class="flex shrink-0 items-center gap-3 text-white">
			{seo?.logo ? (
				<img src={seo.logo} alt={seo.title ?? 'Logo'} width="38" height="38" class="size-[38px] max-sm:size-8" data-tina-field={tinaField(seo, "logo")} />
			) : null}
			<span class="text-[15px] font-bold leading-[1.1] max-sm:whitespace-nowrap max-sm:text-[13px]">
				{seo?.title ?? 'The Lippincott Team'}
				<small class="block text-[10.5px] font-normal uppercase tracking-[0.18em] text-[rgba(246,242,234,0.42)]">eXp Realty</small>
			</span>
		</a>
		<nav aria-label="Main navigation" class="hidden items-center gap-[26px] lg:flex">
			{nav.map((item) => {
				const children = (item.children ?? []).filter(c => c !== null);
				const current = isCurrent(item.link);
				const linkClass = cn(
					'text-sm font-medium whitespace-nowrap transition-colors',
					current ? 'text-white' : 'text-[rgba(246,242,234,0.62)] hover:text-white',
				);
				return children.length > 0 ? (
					<div class="group relative" data-tina-field={tinaField(item, "title")}>
						<a
							href={safeHref(item.link)}
							class={cn(linkClass, 'inline-flex items-center gap-1 py-2')}
							aria-current={current ? 'page' : undefined}
							{...externalAttrs(item.link)}
						>
							{item.title}
							<Icon name="tabler:chevron-down" class="size-3.5" />
						</a>
						<div class="invisible absolute left-0 top-full z-30 min-w-56 pt-1 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
							<div class="rounded-xl border border-[rgba(246,242,234,0.12)] bg-[rgba(23,21,26,0.97)] py-2 shadow-lg backdrop-blur-xl">
								{children.map((child) => (
									<a
										href={safeHref(child.link)}
										class="block px-4 py-2 text-sm text-[rgba(246,242,234,0.62)] transition-colors hover:bg-white/5 hover:text-white"
										{...externalAttrs(child.link)}
									>
										{child.title}
									</a>
								))}
							</div>
						</div>
					</div>
				) : (
					<a
						href={safeHref(item.link)}
						class={linkClass}
						data-tina-field={tinaField(item, "title")}
						aria-current={current ? 'page' : undefined}
						{...externalAttrs(item.link)}
					>
						{item.title}
					</a>
				);
			})}
			{contact?.phone && (
				<a href={telHref(contact.phone)} class="whitespace-nowrap text-sm font-semibold text-white transition-colors">
					{contact.phone}
				</a>
			)}
			<a
				href="/contact-us/"
				class="inline-flex items-center whitespace-nowrap rounded-full bg-[#d6323c] px-5 py-[11px] text-[13px] font-semibold leading-none text-white shadow-[0_10px_26px_rgba(23,21,26,0.28)] transition-[transform,box-shadow] duration-250 hover:-translate-y-0.5 hover:shadow-[0_16px_38px_rgba(23,21,26,0.34)] max-sm:hidden"
			>
				Schedule a Consultation
			</a>
		</nav>
		<button
			id="mobile-menu-toggle"
			type="button"
			aria-label="Toggle navigation menu"
			aria-controls="mobile-menu-panel"
			aria-expanded="false"
			class="relative z-30 inline-flex size-11 cursor-pointer flex-col items-center justify-center gap-[5px] lg:hidden"
		>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
		</button>
	</div>
	<div
		id="mobile-menu-panel"
		inert
		aria-hidden="true"
		class="font-apple pointer-events-none absolute inset-x-0 top-full max-h-[calc(100svh-72px)] overflow-y-auto border-t border-[rgba(246,242,234,0.12)] bg-[#17151a] px-6 pb-[26px] pt-[18px] opacity-0 transition-opacity duration-300 lg:hidden"
	>
		<nav aria-label="Mobile navigation" class="flex flex-col">
			{nav.map((item) => {
				const children = (item.children ?? []).filter(c => c !== null);
				return (
					<>
						<a
							href={safeHref(item.link)}
							class="border-b border-[rgba(246,242,234,0.12)] py-[13px] text-base font-medium text-[#f6f2ea]"
							data-tina-field={tinaField(item, "title")}
							{...externalAttrs(item.link)}
						>
							{item.title}
						</a>
						{children.map((child) => (
							<a
								href={safeHref(child.link)}
								class="border-b border-[rgba(246,242,234,0.12)] py-[13px] pl-4 text-sm text-[rgba(246,242,234,0.62)]"
								{...externalAttrs(child.link)}
							>
								{child.title}
							</a>
						))}
					</>
				);
			})}
			{contact?.phone && (
				<a href={telHref(contact.phone)} class="border-b border-[rgba(246,242,234,0.12)] py-[13px] text-base font-medium text-[#f6f2ea]">
					{contact.phone}
				</a>
			)}
		</nav>
		<a
			href="/contact-us/"
			class="mt-[18px] inline-flex items-center justify-center rounded-full bg-[#d6323c] px-7 py-4 text-center text-sm font-semibold leading-none text-white shadow-[0_10px_26px_rgba(23,21,26,0.28)] transition-[transform,box-shadow] duration-250 hover:-translate-y-0.5 hover:shadow-[0_16px_38px_rgba(23,21,26,0.34)]"
		>
			Schedule a Consultation
		</a>
	</div>
</header>
<style>
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
		opacity: 0;
	}
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}
	#mobile-menu-panel.open {
		opacity: 1;
		pointer-events: auto;
	}
</style>
<script is:inline>
	if (!window.__mobileMenuBound) {
		window.__mobileMenuBound = true;
		const setOpen = (open) => {
			const btn = document.getElementById('mobile-menu-toggle');
			const panel = document.getElementById('mobile-menu-panel');
			if (!btn || !panel) return;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.classList.toggle('open', open);
			panel.toggleAttribute('inert', !open);
			panel.setAttribute('aria-hidden', String(!open));
			document.body.style.overflow = open ? 'hidden' : '';
		};
		document.addEventListener('click', (e) => {
			const toggle = e.target.closest('#mobile-menu-toggle');
			if (toggle) {
				const isOpen = toggle.getAttribute('aria-expanded') === 'true';
				setOpen(!isOpen);
				return;
			}
			if (e.target.closest('#mobile-menu-panel a')) {
				setOpen(false);
			}
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}
</script>
