---
import { Icon } from 'astro-icon/components';
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsConfig } from '../lib/data';
import { safeHref, telHref } from '../lib/url';
import { cn } from '../lib/cn';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const seo = config?.seo ?? null;
const nav = (config?.nav ?? []).filter(item => item !== null);
const contact = config?.contact ?? null;
const isExternal = (href?: string | null) => !!href && /^https?:\/\//.test(href);
const externalAttrs = (href?: string | null) =>
	isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href?: string | null) =>
	!isExternal(href) && ((href ?? '/').replace(/\/+$/, '') || '/') === currentPath;
---

<header class="font-apple sticky top-0 z-20 w-full bg-black/92 backdrop-blur-xl backdrop-saturate-[1.8]">
	<div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-6 px-5 md:px-10">		<a href="/" class="flex shrink-0 items-center gap-2.5 text-white">
			{seo?.logo ? (
				<img src={seo.logo} alt={seo.title ?? 'Logo'} width="34" height="34" class="size-[34px]" data-tina-field={tinaField(seo, "logo")} />
			) : null}
			<span class="text-sm font-semibold leading-tight tracking-[-0.01em]">
				{seo?.title ?? 'The Lippincott Team'}
				<small class="block text-[10px] font-normal uppercase tracking-[0.06em] text-white/55">eXp Realty</small>
			</span>
		</a>
		<nav aria-label="Main navigation" class="hidden items-center gap-6 lg:flex">
			{nav.map((item) => {
				const children = (item.children ?? []).filter(c => c !== null);
				const current = isCurrent(item.link);
				const linkClass = cn(
					'text-xs tracking-[-0.01em] whitespace-nowrap transition-colors',
					current ? 'text-white' : 'text-white/85 hover:text-white',
				);
				return children.length > 0 ? (
					<div class="group relative" data-tina-field={tinaField(item, "title")}>
						<a
							href={safeHref(item.link)}
							class={cn(linkClass, 'inline-flex items-center gap-1 py-2')}
							aria-current={current ? 'page' : undefined}
							{...externalAttrs(item.link)}
						>
							{item.title}
							<Icon name="tabler:chevron-down" class="size-3.5" />
						</a>
						<div class="invisible absolute left-0 top-full z-30 min-w-56 pt-1 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
							<div class="rounded-xl border border-white/10 bg-black/95 py-2 shadow-lg backdrop-blur-xl">
								{children.map((child) => (
									<a
										href={safeHref(child.link)}
										class="block px-4 py-2 text-xs text-white/85 transition-colors hover:bg-white/10 hover:text-white"
										{...externalAttrs(child.link)}
									>
										{child.title}
									</a>
								))}
							</div>
						</div>
					</div>
				) : (
					<a
						href={safeHref(item.link)}
						class={linkClass}
						data-tina-field={tinaField(item, "title")}
						aria-current={current ? 'page' : undefined}
						{...externalAttrs(item.link)}
					>
						{item.title}
					</a>
				);
			})}
			{contact?.phone && (
				<a href={telHref(contact.phone)} class="inline-flex items-center gap-1.5 text-xs text-white/85 transition-colors hover:text-white">
					<Icon name="tabler:phone" class="size-3.5" />
					{contact.phone}
				</a>
			)}
			<a
				href="/contact-us/"
				class="btn-magnetic inline-flex items-center rounded-full bg-primary px-4 py-2 text-sm leading-none text-white transition-colors hover:bg-[#9e1e2c] active:scale-95"
			>
				Schedule a Consultation
			</a>
		</nav>
		<button
			id="mobile-menu-toggle"
			type="button"
			aria-label="Toggle navigation menu"
			aria-controls="mobile-menu-panel"
			aria-expanded="false"
			class="relative z-30 inline-flex size-11 cursor-pointer flex-col items-center justify-center gap-[5px] lg:hidden"
		>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
			<span class="menu-bar block h-[1.5px] w-[22px] bg-white transition-all duration-300"></span>
		</button>
	</div>
</header>
<div
	id="mobile-menu-panel"
	inert
	aria-hidden="true"
	class="font-apple pointer-events-none fixed inset-0 z-10 flex flex-col gap-1 overflow-y-auto bg-section px-8 pb-10 pt-24 opacity-0 transition-opacity duration-300 lg:hidden"
>
	{nav.map((item) => {
		const children = (item.children ?? []).filter(c => c !== null);
		return (
			<>
				<a
					href={safeHref(item.link)}
					class="border-b border-hairline py-3.5 text-2xl font-semibold tracking-[-0.02em] text-ink"
					data-tina-field={tinaField(item, "title")}
					{...externalAttrs(item.link)}
				>
					{item.title}
				</a>
				{children.map((child) => (
					<a
						href={safeHref(child.link)}
						class="border-b border-hairline py-3 pl-4 text-lg text-body"
						{...externalAttrs(child.link)}
					>
						{child.title}
					</a>
				))}
			</>
		);
	})}
	<a
		href="/contact-us/"
		class="mt-7 inline-flex items-center justify-center rounded-full bg-primary px-6 py-3.5 text-center text-lg leading-snug text-white active:scale-95"
	>
		Schedule a Consultation
	</a>
</div>
<style>
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
		transform: translateY(6.5px) rotate(45deg);
	}
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
		opacity: 0;
	}
	#mobile-menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
		transform: translateY(-6.5px) rotate(-45deg);
	}
	#mobile-menu-panel.open {
		opacity: 1;
		pointer-events: auto;
	}
</style>
<script is:inline>
	if (!window.__mobileMenuBound) {
		window.__mobileMenuBound = true;
		const setOpen = (open) => {
			const btn = document.getElementById('mobile-menu-toggle');
			const panel = document.getElementById('mobile-menu-panel');
			if (!btn || !panel) return;
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.classList.toggle('open', open);
			panel.toggleAttribute('inert', !open);
			panel.setAttribute('aria-hidden', String(!open));
			document.body.style.overflow = open ? 'hidden' : '';
		};
		document.addEventListener('click', (e) => {
			const toggle = e.target.closest('#mobile-menu-toggle');
			if (toggle) {
				const isOpen = toggle.getAttribute('aria-expanded') === 'true';
				setOpen(!isOpen);
				return;
			}
			if (e.target.closest('#mobile-menu-panel a')) {
				setOpen(false);
			}
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setOpen(false);
		});
	}
</script>
