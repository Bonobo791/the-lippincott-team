---
import type { HTMLTag } from 'astro/types';
import { splitHeading } from '../../lib/split-heading';

// Split-heading variant for the .home-v2 design system: the accent phrase
// renders as <em> so v2.css's per-section `em` styling (red on light bands,
// gold on dark) applies exactly as it did to hand-written markup.
type Props = {
	/** Raw heading string; `**accent**` segments render as <em>. */
	text: string;
	as?: HTMLTag;
	class?: string;
	[key: string]: unknown;
};

const { text, as: Tag = 'h2', class: className, ...rest } = Astro.props;
const segments = splitHeading(text);
---

<Tag class={className} {...rest}>
	{segments.map((segment) => (segment.accent ? <em>{segment.text}</em> : <Fragment>{segment.text}</Fragment>))}
</Tag>
