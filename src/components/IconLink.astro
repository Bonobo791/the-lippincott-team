---
import { mediaUrl } from '../lib/media';
const mediaSite = Astro.site?.href ?? Astro.url.origin;
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';
import { safeHref } from '../lib/url';

type Props = HTMLAttributes<'a'> & {
	title?: string | null;
	link?: string | null;
	/** Any Iconify icon name, e.g. "tabler:brand-x". */
	icon?: string | null;
};

const { title, link, icon, ...rest } = Astro.props;
const safeTitle = title ?? '';
const safeLink = mediaUrl(safeHref(link), mediaSite) ?? '#';
---

<a href={safeLink} target="_blank" aria-label={`Go to ${safeTitle}`} {...rest} rel="noopener">
	<span class="sr-only">{safeTitle}</span>
	{icon && <Icon name={icon} size={32} />}
</a>
