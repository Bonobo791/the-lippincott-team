---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { Icon } from 'astro-icon/components';
import { mdxComponents } from '../mdx/components';
import V2Heading from '../v2/V2Heading.astro';
import HarReviewFeed from './HarReviewFeed.astro';
import { getConfig, type CmsStandalone } from '../../lib/data';
import { linkTargetAttrs, safeHref, telHref } from '../../lib/url';
import { hasRichText } from '../../lib/rich-text';

interface Props { data?: Extract<CmsStandalone, { __typename: 'StandaloneReviews' }> | null }
const { data } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
const phone = config?.contact?.phone ?? null;
const socials = (config?.contactLinks ?? []).filter((s) => s !== null);

const head = data?.head;
const record = data?.record;
const featured = data?.featured;
const feed = data?.feed;
const verify = data?.verify;
const faq = data?.faq;
const finalCta = data?.finalCta;

const extAttrs = (link?: string | null) => linkTargetAttrs(link);
const feedNoteParts = feed?.feedNote?.split('{profile}') ?? null;
const feedProfileHref = safeHref(feed?.profileUrl) ?? null;
// Fewer than two slides renders a static figure — the arrows/dots script
// early-returns at the same threshold, so the controls must not render.
const featuredReviews = (featured?.reviews ?? []).filter((r) => r !== null);
---

{data && (
<div class="home-v2">
	{head && (
		<section class="band" data-tina-field={tinaField(data, 'head')}>
			<div class="wrap">
				{head.eyebrow && <span class="eyebrow red reveal" data-tina-field={tinaField(head, 'eyebrow')}>{head.eyebrow}</span>}
				{head.heading && <V2Heading as="h1" text={head.heading} class="display reveal" data-tina-field={tinaField(head, 'heading')} />}
				{hasRichText(head.lede) && (
					<div class="lede reveal" data-tina-field={tinaField(head, 'lede')}>
						<TinaMarkdown content={head.lede} components={mdxComponents} />
					</div>
				)}
			</div>
		</section>
	)}

	{record && (
		<section class="band ink dark" data-tina-field={tinaField(data, 'record')}>
			<div class="wrap">
				{record.eyebrow && <span class="eyebrow gold reveal" data-tina-field={tinaField(record, 'eyebrow')}>{record.eyebrow}</span>}
				{record.heading && <V2Heading text={record.heading} class="display sec reveal" data-tina-field={tinaField(record, 'heading')} />}
				<div class="dgrid four spaced reveal" data-tina-field={tinaField(record, 'tiles')}>
					{(record.tiles ?? []).filter((t) => t !== null).map((t) => {
						const num = (
							<span class:list={['num', { gold: t.gold }]} data-count={t.count ?? undefined} data-suffix={t.suffix ?? undefined}>
								{t.count != null ? `${t.count.toLocaleString('en-US')}${t.suffix ?? ''}` : t.num}{t.tail && <span>{t.tail}</span>}
							</span>
						);
						return (
							<div class="dtile" data-tina-field={tinaField(t)}>
								{safeHref(t.link) ? <a href={safeHref(t.link)} {...extAttrs(t.link)}>{num}</a> : num}
								<span class="slabel">{t.slabel}</span>
								{t.ssrc && <span class="ssrc">{t.ssrc}</span>}
							</div>
						);
					})}
				</div>
				{record.cta?.link && <p class="sec-cta gold reveal"><a class="link-arrow" href={safeHref(record.cta.link)} {...extAttrs(record.cta.link)} data-tina-field={tinaField(record.cta)}>{record.cta.label}</a></p>}
			</div>
		</section>
	)}

	{featured && (
		<section class="band ink dark" data-tina-field={tinaField(data, 'featured')}>
			<div class="wrap">
				{featured.eyebrow && <span class="eyebrow gold reveal" data-tina-field={tinaField(featured, 'eyebrow')}>{featured.eyebrow}</span>}
				{featured.heading && <V2Heading text={featured.heading} class="display sec reveal" data-tina-field={tinaField(featured, 'heading')} />}
				{hasRichText(featured.lede) && (
					<div class="lede reveal" data-tina-field={tinaField(featured, 'lede')}>
						<TinaMarkdown content={featured.lede} components={mdxComponents} />
					</div>
				)}
				{featuredReviews.length > 0 && (
				<div class="carousel reveal" data-reviews-carousel aria-roledescription="carousel" aria-label="Featured client reviews">
					<div class="car-viewport">
						<div class="car-track" data-car-track data-tina-field={tinaField(featured, 'reviews')}>
							{featuredReviews.map((review, i) => (
								<figure class="car-slide" data-car-slide aria-hidden={i !== 0} data-tina-field={tinaField(review)}>
									<blockquote>&ldquo;{review.quote}&rdquo;</blockquote>
									<figcaption>
										<span class="stars" aria-hidden="true">★★★★★</span>
										{review.src}
									</figcaption>
								</figure>
							))}
						</div>
					</div>
					{featuredReviews.length > 1 && (
						<>
							<button type="button" class="car-arrow prev" data-car-prev aria-label="Previous review">&#8592;</button>
							<button type="button" class="car-arrow next" data-car-next aria-label="Next review">&#8594;</button>
							<div class="car-dots" data-car-dots aria-label="Choose review"></div>
						</>
					)}
				</div>
				)}
				{featured.cta?.link && <p class="sec-cta gold reveal"><a class="link-arrow" href={safeHref(featured.cta.link)} {...extAttrs(featured.cta.link)} data-tina-field={tinaField(featured.cta)}>{featured.cta.label}</a></p>}
			</div>
		</section>
	)}

	{feed && (
		<section class="band" data-tina-field={tinaField(data, 'feed')}>
			<div class="wrap">
				{feed.eyebrow && <span class="eyebrow red reveal" data-tina-field={tinaField(feed, 'eyebrow')}>{feed.eyebrow}</span>}
				{feed.heading && <V2Heading text={feed.heading} class="display sec reveal" data-tina-field={tinaField(feed, 'heading')} />}
				{hasRichText(feed.lede) && (
					<div class="lede reveal" data-tina-field={tinaField(feed, 'lede')}>
						<TinaMarkdown content={feed.lede} components={mdxComponents} />
					</div>
				)}
				<div class="feed reveal">
					<HarReviewFeed memberNumber={feed.memberNumber} profileUrl={feedProfileHref} />
					{feedNoteParts && (
						<p class="feed-note" data-tina-field={tinaField(feed, 'feedNote')}>
							{feedNoteParts[0]}
							{feedNoteParts.length > 1 && feedProfileHref && <a href={feedProfileHref} {...extAttrs(feed.profileUrl)}>{feed.feedNoteLabel ?? feed.profileUrl}</a>}
							{feedNoteParts.slice(1).join('{profile}')}
						</p>
					)}
				</div>
				{feed.cta?.link && <p class="sec-cta reveal"><a class="link-arrow" href={safeHref(feed.cta.link)} {...extAttrs(feed.cta.link)} data-tina-field={tinaField(feed.cta)}>{feed.cta.label}</a></p>}
			</div>
		</section>
	)}

	{verify && (
		<section class="band ivory" data-tina-field={tinaField(data, 'verify')}>
			<div class="wrap">
				{verify.eyebrow && <span class="eyebrow red reveal" data-tina-field={tinaField(verify, 'eyebrow')}>{verify.eyebrow}</span>}
				{verify.heading && <V2Heading text={verify.heading} class="display sec reveal" data-tina-field={tinaField(verify, 'heading')} />}
				{hasRichText(verify.lede) && (
					<div class="lede reveal" data-tina-field={tinaField(verify, 'lede')}>
						<TinaMarkdown content={verify.lede} components={mdxComponents} />
					</div>
				)}
				<div class="jobs three reveal" style="margin-top:48px" data-tina-field={tinaField(verify, 'cards')}>
					{(verify.cards ?? []).filter((c) => c !== null).map((card) => (
						<div class="job" data-tina-field={tinaField(card)}>
							<span class="tag red">{card.tag}</span>
							<h3>{card.title}</h3>
							<TinaMarkdown content={card.body} components={mdxComponents} />
							{card.link && <a class="link-arrow" href={safeHref(card.link)} {...extAttrs(card.link)}>{card.linkLabel}</a>}
						</div>
					))}
				</div>
				{socials.length > 0 && (
					<div class="social-row reveal">
						<span class="social-label" data-tina-field={tinaField(verify, 'socialLabel')}>{verify.socialLabel}</span>
						<div class="social-btns">
							{socials.map((s) => (
								<a class="social-btn" href={safeHref(s.link)} {...extAttrs(s.link)}>{s.icon && <Icon name={s.icon} size={18} />}<span>{s.title}</span></a>
							))}
						</div>
					</div>
				)}
				{verify.cta?.link && <p class="sec-cta reveal"><a class="link-arrow" href={safeHref(verify.cta.link)} {...extAttrs(verify.cta.link)} data-tina-field={tinaField(verify.cta)}>{verify.cta.label}</a></p>}
			</div>
		</section>
	)}

	{faq && (
		<section class="faq" data-tina-field={tinaField(data, 'faq')}>
			<div class="wrap">
				{faq.heading && <V2Heading text={faq.heading} class="display sec reveal" data-tina-field={tinaField(faq, 'heading')} />}
				<div class="faq-list" data-tina-field={tinaField(faq, 'items')}>
					{(faq.items ?? []).filter((q) => q !== null).filter((q) => q.question?.trim() && hasRichText(q.answer)).map((q) => (
						<details class="reveal" data-tina-field={tinaField(q)}>
							<summary>{q.question} <span class="plus">+</span></summary>
							<TinaMarkdown content={q.answer} components={mdxComponents} />
						</details>
					))}
				</div>
				{faq.cta?.link && <p class="sec-cta reveal"><a class="link-arrow" href={safeHref(faq.cta.link)} {...extAttrs(faq.cta.link)} data-tina-field={tinaField(faq.cta)}>{faq.cta.label}</a></p>}
			</div>
		</section>
	)}

	{finalCta && (
		<section class="final dark" data-tina-field={tinaField(data, 'finalCta')}>
			<div class="reveal">
				{finalCta.heading && <V2Heading text={finalCta.heading} data-tina-field={tinaField(finalCta, 'heading')} />}
				{finalCta.body && <p data-tina-field={tinaField(finalCta, 'body')}>{finalCta.body}</p>}
				<div class="final-actions">
					{finalCta.primary?.link && <a class="btn" href={safeHref(finalCta.primary.link)} {...extAttrs(finalCta.primary.link)} data-tina-field={tinaField(finalCta.primary)}>{finalCta.primary.label}</a>}
					{finalCta.showPhone && phone && <a class="text-link" href={telHref(phone)}>Call {phone} →</a>}
				</div>
			</div>
		</section>
	)}
</div>
)}
