---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import FormattedDate from '../FormattedDate.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { mdxComponents } from '../mdx/components';
import { listBlogs, type CmsStandalone } from '../../lib/data';
import { linkTargetAttrs, safeHref } from '../../lib/url';
import { hasRichText } from '../../lib/rich-text';

interface Props { data?: Extract<CmsStandalone, { __typename: 'StandaloneBlogIndex' }> | null }
const { data } = Astro.props;

const posts = await listBlogs();
const [featured, ...rest] = posts;
const linkArrow = 'mt-4 inline-flex items-center gap-2 text-sm font-semibold text-primary no-underline transition-[gap] duration-200 hover:gap-3';
const cta = data?.cta;
---

{data && (
<Fragment>
	<section class="pt-12 pb-10 md:pt-16 md:pb-12" data-tina-field={tinaField(data)}>
		<div class="mx-auto max-w-[1200px] px-6 md:px-12">
			{data.eyebrow && <p class="eyebrow" data-tina-field={tinaField(data, 'eyebrow')}>{data.eyebrow}</p>}
			{data.heading && (
				<div class="h2-mask mt-4">
					<SplitHeading as="h1" text={data.heading} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'heading')} class="max-w-[24ch] text-balance text-[clamp(2.2rem,4.5vw,3.5rem)] font-serif font-light leading-[1.08] tracking-[-0.02em] text-ink" />
				</div>
			)}
			{data.lede && <p class="mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-body" data-tina-field={tinaField(data, 'lede')}>{data.lede}</p>}
		</div>
	</section>
	{featured && (
		<section class="pb-12 md:pb-16">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<a href={`/blog/${featured._sys.filename}/`} class="group block border border-border bg-background p-8 no-underline transition-colors duration-300 hover:bg-section md:p-12">
					<span class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">
						{data.featuredLabel}{featured.category ? ` · ${featured.category}` : ''}{featured.pubDate && <> · <FormattedDate date={new Date(featured.pubDate)} /></>}
					</span>
					<h2 class="mt-4 max-w-[24ch] font-serif text-[clamp(1.75rem,3.4vw,2.75rem)] font-light leading-[1.15] tracking-[-0.02em] text-ink">{featured.title}</h2>
					{featured.description && <p class="mt-4 max-w-[62ch] text-[15px] leading-relaxed text-muted-foreground">{featured.description}</p>}
					<span class={linkArrow}>{data.readLabel} <span aria-hidden="true">→</span></span>
				</a>
			</div>
		</section>
	)}
	{rest.length > 0 && (
		<section class="pb-16 md:pb-24">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<div class="grid gap-px border border-border bg-border md:grid-cols-2">
					{rest.map((post) => (
						<a href={`/blog/${post._sys.filename}/`} class="group flex flex-col gap-5 bg-background p-6 no-underline transition-colors duration-300 hover:bg-section sm:flex-row md:p-7">
							{post.heroImage && (
								<img src={post.heroImage} alt={post.title ?? ''} width={400} height={300} loading="lazy" class="aspect-[4/3] w-full shrink-0 rounded-lg object-cover sm:w-40" />
							)}
							<div>
								<span class="text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">
									{post.category ?? data.fallbackCategory ?? 'Guides'}{post.pubDate && <> · <FormattedDate date={new Date(post.pubDate)} /></>}
								</span>
								<h2 class="mt-2.5 font-serif text-xl font-light leading-snug tracking-[-0.01em] text-ink">{post.title}</h2>
								{post.description && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{post.description}</p>}
								<span class={linkArrow}>{data.readLabel} <span aria-hidden="true">→</span></span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	)}
	{cta && (
		<section class="relative overflow-hidden bg-tile py-16 text-center text-white md:py-24" data-blog-cta data-tina-field={tinaField(data, 'cta')}>
			<div class="relative z-[2] mx-auto max-w-[1200px] px-6 md:px-12">
				{cta.heading && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={cta.heading} accentClass="font-normal italic text-gold" data-tina-field={tinaField(cta, 'heading')} class="mx-auto max-w-[22ch] text-balance text-[clamp(2rem,3.8vw,3rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-white" />
					</div>
				)}
				{hasRichText(cta.body) && (
					<div class="prose mx-auto mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] [--tw-prose-body:rgba(255,255,255,.85)] [--tw-prose-links:rgba(255,255,255,.9)]" data-tina-field={tinaField(cta, 'body')}>
						<TinaMarkdown content={cta.body} components={mdxComponents} />
					</div>
				)}
				<div class="mt-9 flex flex-wrap items-center justify-center gap-4">
					{cta.primary?.link && (
						<a
							href={safeHref(cta.primary.link)}
							data-tina-field={tinaField(cta.primary)}
							{...linkTargetAttrs(cta.primary.link)}
							class="btn-magnetic inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 py-4 text-sm font-semibold text-white no-underline shadow-lg transition-colors duration-200 hover:bg-primary/90 active:scale-95"
						>{cta.primary.label} <span aria-hidden="true">→</span></a>
					)}
					{cta.secondary?.link && (
						<a href={safeHref(cta.secondary.link)} {...linkTargetAttrs(cta.secondary.link)} data-tina-field={tinaField(cta.secondary)} class="inline-flex items-center whitespace-nowrap rounded-full border border-white/30 px-7 py-4 text-sm font-semibold text-white no-underline transition-colors duration-200 hover:border-white hover:bg-white/10">{cta.secondary.label}</a>
					)}
				</div>
			</div>
		</section>
	)}
	<style>
		[data-blog-cta]::after {
			content: '';
			position: absolute;
			inset: auto 0 0 0;
			height: 45%;
			background: radial-gradient(55% 90% at 50% 115%, rgba(214, 50, 60, 0.2), transparent 70%);
			pointer-events: none;
		}
	</style>
</Fragment>
)}
