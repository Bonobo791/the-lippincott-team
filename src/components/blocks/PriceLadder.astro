---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import { hasRichText } from '../../lib/rich-text';
import { safeHref, isExternal } from '../../lib/url';
import type { PriceLadderBlock } from '../../lib/data';

interface Props { data: Omit<PriceLadderBlock, '__typename'> }

const { data } = Astro.props;
const rows = (data.rows ?? []).filter(r => r !== null);
// Split the ladder into two balanced columns (design: 4+4 side by side).
const half = Math.ceil(rows.length / 2);
const columns = [rows.slice(0, half), rows.slice(half)].filter(c => c.length > 0);
---
<section class="bg-section py-12 md:py-16" data-ladder>
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{(data.title || hasRichText(data.summary)) && (
			<div class="mb-10 grid gap-4 md:mb-14">
				{data.title && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
					</div>
				)}
				{hasRichText(data.summary) && (
					<div data-tina-field={tinaField(data, 'summary')} class="prose max-w-[56ch] text-[clamp(17px,1.6vw,21px)] [--tw-prose-body:var(--color-body)]">
						<TinaMarkdown content={data.summary} components={mdxComponents} />
					</div>
				)}
			</div>
		)}
		{columns.length > 0 && (
			<div class="grid gap-x-16 md:grid-cols-2">
				{columns.map((col) => (
					<div class="border-t border-hairline">
						{col.map((row) => {
							const href = safeHref(row.link);
							const w = typeof row.weight === 'number' ? Math.min(Math.max(row.weight, 0), 100) / 100 : 1;
							const inner = (
								<>
									<span class="flex items-baseline justify-between gap-6">
										<span class="text-[15px] font-medium text-ink transition-colors duration-200 group-hover:text-primary">{row.name}</span>
										{row.figure && <span class="whitespace-nowrap text-[clamp(1.35rem,2.4vw,1.85rem)] font-serif font-light tracking-[-0.01em] text-ink">{row.figure}</span>}
									</span>
									<span class="mt-3 block h-[3px] w-full bg-hairline" aria-hidden="true">
										<span class={`ladder-bar block h-full ${row.highlight ? 'bg-primary' : 'bg-ink'}`} style={`--w:${w}`}></span>
									</span>
								</>
							);
							return href ? (
								<a href={href} data-tina-field={tinaField(row)} {...(isExternal(row.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})} class="group block border-b border-hairline py-5 no-underline">
									{inner}
								</a>
							) : (
								<div data-tina-field={tinaField(row)} class="group border-b border-hairline py-5">
									{inner}
								</div>
							);
						})}
					</div>
				))}
			</div>
		)}
		{hasRichText(data.note) && (
			<div data-tina-field={tinaField(data, 'note')} class="prose mt-7 max-w-[68ch] text-sm leading-relaxed [--tw-prose-body:var(--color-muted-foreground)]">
				<TinaMarkdown content={data.note} components={mdxComponents} />
			</div>
		)}
	</div>
</section>
<style>
	.ladder-bar {
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s;
	}
	[data-ladder].in .ladder-bar {
		transform: scaleX(var(--w, 1));
	}
	@media (prefers-reduced-motion: reduce) {
		.ladder-bar {
			transform: scaleX(var(--w, 1));
			transition: none;
		}
	}
</style>
<script is:inline>
	if (!window.__ladderBound) {
		window.__ladderBound = true;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let ladderObs = null;
		const initLadders = () => {
			document.querySelectorAll('[data-ladder]').forEach((s) => {
				if (s.dataset.ladderBound) return;
				s.dataset.ladderBound = '1';
				if (reduced || !('IntersectionObserver' in window)) { s.classList.add('in'); return; }
				ladderObs = ladderObs || new IntersectionObserver((entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) { e.target.classList.add('in'); ladderObs.unobserve(e.target); }
					});
				}, { threshold: 0.2 });
				ladderObs.observe(s);
			});
		};
		document.addEventListener('astro:page-load', initLadders);
		document.addEventListener('astro:before-swap', () => {
			if (ladderObs) { ladderObs.disconnect(); ladderObs = null; }
		});
	}
</script>
