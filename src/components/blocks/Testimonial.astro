---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import type { TestimonialBlock, TestimonialItem } from '../../lib/data';

interface Props { data: TestimonialBlock }

const { data } = Astro.props;
// Static dark panel — render up to 2 quotes, no carousel (per design spec).
const testimonials = (data.testimonials ?? [])
	.filter((t): t is TestimonialItem => t !== null)
	.slice(0, 2);
---
<Section>
	<div class="rounded-3xl bg-secondary px-8 py-12 md:px-12 md:py-16 lg:px-16">
		<div class="grid items-center gap-10 lg:grid-cols-[2fr_3fr]">
			<div class="text-center lg:text-left">
				<h2 data-tina-field={tinaField(data, 'title')} class="text-3xl font-light text-white lg:text-4xl">{data.title}</h2>
				<p data-tina-field={tinaField(data, 'description')} class="mt-4 text-white/70">{data.description}</p>
			</div>
			<div class="space-y-6">
				{testimonials.map((t) => (
					<figure data-tina-field={tinaField(t)} class="rounded-2xl bg-white/5 p-8 text-center ring-1 ring-white/10">
						<blockquote>
							<p data-tina-field={tinaField(t, 'quote')} class="text-lg italic text-white">{t.quote}</p>
						</blockquote>
						<figcaption class="mt-4">
							<span data-tina-field={tinaField(t, 'author')} class="block font-semibold text-white">{t.author}</span>
							<span data-tina-field={tinaField(t, 'role')} class="mt-1 block text-sm text-white/60">{t.role}</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</div>
</Section>
