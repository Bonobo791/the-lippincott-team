---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import type { ContactFormBlock } from '../../lib/data';

interface Props { data: ContactFormBlock }

const { data } = Astro.props;

const fieldClasses =
	'mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-xs outline-none transition-colors placeholder:text-muted-foreground focus:border-ring focus:ring-[3px] focus:ring-ring/50';
---
<Section>
	<div class="mx-auto max-w-2xl">
		{data.heading && <h2 data-tina-field={tinaField(data, 'heading')} class="text-center text-3xl font-semibold tracking-tight">{data.heading}</h2>}
		{data.intro && <p data-tina-field={tinaField(data, 'intro')} class="mt-4 text-center text-muted-foreground">{data.intro}</p>}
		{/*
			Submissions go to Netlify Forms (static, no JS needed). When Sierra API
			lead forwarding lands, the endpoint swaps to a Netlify Function — this
			block and page stay unchanged.
		*/}
		<form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="mt-10 rounded-2xl border p-6 shadow-sm sm:p-8">
			<input type="hidden" name="form-name" value="contact" />
			<p class="hidden" aria-hidden="true">
				<label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
			</p>
			<div class="grid gap-5 sm:grid-cols-2">
				<div>
					<label for="contact-name" class="text-sm font-medium">Name <span aria-hidden="true" class="text-primary">*</span></label>
					<input id="contact-name" name="name" type="text" required autocomplete="name" class={fieldClasses} />
				</div>
				<div>
					<label for="contact-email" class="text-sm font-medium">Email <span aria-hidden="true" class="text-primary">*</span></label>
					<input id="contact-email" name="email" type="email" required autocomplete="email" class={fieldClasses} />
				</div>
				<div class="sm:col-span-2">
					<label for="contact-phone" class="text-sm font-medium">Phone</label>
					<input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={fieldClasses} />
				</div>
				<div class="sm:col-span-2">
					<label for="contact-message" class="text-sm font-medium">Message <span aria-hidden="true" class="text-primary">*</span></label>
					<textarea id="contact-message" name="message" required rows={5} class={fieldClasses}></textarea>
				</div>
			</div>
			<div class="mt-6">
				<Button size="lg" class="w-full sm:w-auto">Send Message</Button>
			</div>
		</form>
	</div>
</Section>
