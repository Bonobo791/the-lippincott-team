---
import { tinaField } from '@tinacms/astro/tina-field';
import SplitHeading from '../ui/SplitHeading.astro';
import { getConfig, type ContactFormBlock } from '../../lib/data';
import { telHref } from '../../lib/url';

interface Props { data: ContactFormBlock }

const { data } = Astro.props;
// Rail contact rows come from the site config (single source for phone/email).
const contact = (await getConfig()).data?.config?.contact ?? null;
// Config stores "713-494-1818"; the design displays "(713) 494-1818". Parse
// digit-first so dots/parens/spaces in the config don't break the format.
const phoneDigits = (contact?.phone ?? '').replace(/\D/g, '');
const phoneDisplay = phoneDigits.length === 10
	? `(${phoneDigits.slice(0, 3)}) ${phoneDigits.slice(3, 6)}-${phoneDigits.slice(6)}`
	: (contact?.phone ?? null);

const fieldClasses =
	'mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm shadow-xs outline-none transition-colors placeholder:text-muted-foreground focus:border-ring focus:ring-[3px] focus:ring-ring/50';
const labelClasses = 'text-[13px] font-semibold text-ink';

// "What happens next": editor-overridable via the block's steps field; these
// are the design's defaults when the field is unset.
const defaultSteps = [
	{ n: '01', title: 'We review your note', body: 'A specialist reads your goals before anyone calls you.' },
	{ n: '02', title: 'You get a plan', body: 'Pricing data, neighborhood comparisons or a tour list, matched to your move.' },
	{ n: '03', title: 'You decide', body: 'No obligation either way. The data is yours to keep.' },
];
const editedSteps = (data.steps ?? []).flatMap((s) => (s?.title ? [{ title: s.title, body: s.body ?? '' }] : []));
const steps = (editedSteps.length > 0 ? editedSteps : defaultSteps)
	.map((step, i) => ({ ...step, n: String(i + 1).padStart(2, '0') }));
const assurances = [
	{ title: 'Free consultation', body: 'Pricing analysis and neighborhood comparisons cost nothing.' },
	{ title: 'One business day', body: 'A named specialist responds, not an autoresponder.' },
	{ title: '4.9 rated, verified', body: '750+ five-star reviews across Google and HAR.com.' },
];
---
<>
	<section class="pt-12 pb-10 md:pt-16 md:pb-12">
		<div class="mx-auto max-w-[1200px] px-6 md:px-12">
			{data.heading && (
				<div class="h2-mask">
					<SplitHeading as="h1" text={data.heading} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'heading')} class="max-w-[24ch] text-balance text-[clamp(2.2rem,4.5vw,3.5rem)] font-serif font-light leading-[1.08] tracking-[-0.02em] text-ink" />
				</div>
			)}
			{data.intro && <p data-tina-field={tinaField(data, 'intro')} class="mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-body">{data.intro}</p>}
		</div>
	</section>
	<section class="pb-16 md:pb-24">
		<div class="mx-auto grid max-w-[1200px] items-start gap-12 px-6 md:px-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16">
			{/* Submissions POST to /api/contact, which forwards the lead to Sierra on
		   every host (Netlify, Coolify, the standalone Node server). The hidden
		   bot-field is a honeypot the endpoint silently drops. */}
			<form name="contact" method="POST" action="/api/contact" class="rounded-2xl border border-border bg-background p-6 sm:p-10">
				<input type="hidden" name="form-name" value="contact" />
				<p class="hidden" aria-hidden="true">
					<label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
				</p>
				<div class="grid gap-5 sm:grid-cols-2">
					<div>
						<label for="contact-name" class={labelClasses}>Full name <span aria-hidden="true" class="text-primary">*</span></label>
						<input id="contact-name" name="name" type="text" required autocomplete="name" placeholder="Jordan Meyers" class={fieldClasses} />
					</div>
					<div>
						<label for="contact-phone" class={labelClasses}>Phone</label>
						<input id="contact-phone" name="phone" type="tel" autocomplete="tel" placeholder="(713) 555-0142" class={fieldClasses} />
						<span class="mt-1.5 block text-xs text-muted-foreground">Optional, but fastest for scheduling.</span>
					</div>
					<div class="sm:col-span-2">
						<label for="contact-email" class={labelClasses}>Email <span aria-hidden="true" class="text-primary">*</span></label>
						<input id="contact-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class={fieldClasses} />
					</div>
					<div class="sm:col-span-2">
						<label for="contact-interest" class={labelClasses}>I want to</label>
						<select id="contact-interest" name="interest" class={fieldClasses}>
							<option value="Sell my home">Sell my home</option>
							<option value="Buy a home">Buy a home</option>
							<option value="Buy and sell at once">Buy and sell at once</option>
							<option value="Relocate to Northwest Houston">Relocate to Northwest Houston</option>
							<option value="Get a home valuation">Get a home valuation</option>
						</select>
					</div>
					<div class="sm:col-span-2">
						<label for="contact-message" class={labelClasses}>Anything we should know?</label>
						<textarea id="contact-message" name="message" rows={5} placeholder="Timeline, neighborhoods on your list, must-haves." class={fieldClasses}></textarea>
					</div>
				</div>
				<button type="submit" class="btn-magnetic mt-7 inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 py-4 text-sm font-semibold text-white no-underline shadow-lg transition-colors duration-200 hover:bg-primary/90 active:scale-95 motion-reduce:active:scale-100 motion-reduce:transition-none disabled:opacity-60">
					Request my consultation <span aria-hidden="true">→</span>
				</button>
				<p id="contact-error" class="mt-4 hidden text-sm font-medium text-primary" role="alert"></p>
				<p class="mt-4 text-xs text-muted-foreground">Free and without obligation. Your details go straight to our team through a secure client-management system and are never sold.</p>
			</form>
			<aside>
				{phoneDisplay && contact?.phone && (
					<div class="border-t border-border py-7 first:border-t-0 first:pt-0">
						<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Call or text</span>
						<a href={telHref(contact.phone)} class="mt-2.5 block font-serif text-[clamp(1.5rem,2.4vw,1.9rem)] font-light tracking-[-0.01em] text-ink no-underline transition-colors hover:text-primary">{phoneDisplay}</a>
					</div>
				)}
				{contact?.email && (
					<div class="border-t border-border py-7">
						<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Email</span>
						<a href={`mailto:${contact.email}`} class="mt-2.5 block break-all font-serif text-xl font-light tracking-[-0.01em] text-ink no-underline transition-colors hover:text-primary">{contact.email}</a>
					</div>
				)}
				<div class="border-t border-border pt-7">
					<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">What happens next</span>
					<ol class="mt-2 list-none p-0" data-tina-field={tinaField(data, 'steps')}>
						{steps.map((step) => (
							<li class="flex gap-5 border-t border-border py-5 first:border-t-0">
								<span class="font-serif text-sm text-gold">{step.n}</span>
								<div>
									<b class="text-[15px] font-semibold text-ink">{step.title}</b>
									{step.body && <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{step.body}</p>}
								</div>
							</li>
						))}
					</ol>
				</div>
			</aside>
		</div>
	</section>
	<section class="bg-section py-16 md:py-24">
		<div class="mx-auto grid max-w-[1200px] gap-10 px-6 md:grid-cols-3 md:gap-8 md:px-12">
			{assurances.map((item) => (
				<div>
					<b class="text-[15px] font-semibold text-ink">{item.title}</b>
					<p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.body}</p>
				</div>
			))}
		</div>
	</section>
	<script>
		// Progressive enhancement: POST to /api/contact and follow the 303 to the
		// thank-you page on success. Without JS the native POST works the same.
		// Bound on astro:page-load so a form swapped in by <ClientRouter/> also
		// gets its submit listener (the per-node dataset guard prevents
		// double-binding when the same node persists).
		const bindContactForm = () => {
			const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
			const errorBox = document.getElementById('contact-error');
			if (!form || form.dataset.bound) return;
			form.dataset.bound = '1';
			const showError = (message: string) => {
				if (!errorBox) return;
				errorBox.textContent = message;
				errorBox.classList.remove('hidden');
			};
			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				errorBox?.classList.add('hidden');
				const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
				if (button) button.disabled = true;
				try {
					const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
					if (response.redirected) {
						window.location.assign(response.url);
						return;
					}
					const payload = await response.json().catch(() => null);
					showError(payload?.error ?? 'Something went wrong. Please try again, or call or text us directly.');
				} catch {
					showError('Network error. Please check your connection and try again.');
				} finally {
					if (button) button.disabled = false;
				}
			});
		};
		document.addEventListener('astro:page-load', bindContactForm);
	</script>
</>
