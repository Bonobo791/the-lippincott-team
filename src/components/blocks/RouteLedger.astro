---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import type { RouteLedgerBlock } from '../../lib/data';

interface Props { data: Omit<RouteLedgerBlock, '__typename'> }

const { data } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
const routes = (data.routes ?? []).filter(r => r !== null);
---
<section class="bg-section py-20 md:py-28">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{(data.title || data.summary) && (
			<div class="mb-8 grid gap-4 md:mb-10">
				{data.title && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
					</div>
				)}
				{data.summary && (
					<div data-tina-field={tinaField(data, 'summary')} class="prose max-w-[56ch] text-[clamp(17px,1.6vw,21px)] [--tw-prose-body:var(--color-body)]">
						<TinaMarkdown content={data.summary} components={mdxComponents} />
					</div>
				)}
			</div>
		)}
		{chips.length > 0 && (
			<div class="mb-7 flex flex-wrap gap-3">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body">
						{chip.bold && <b class="font-semibold text-ink">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
		{routes.length > 0 && (
			<div class="border-t border-hairline">
				{routes.map((route) => (
					<div data-tina-field={tinaField(route)} class="grid gap-1 border-b border-hairline py-4 md:grid-cols-[minmax(170px,230px)_1fr] md:gap-7 md:py-[18px]">
						<span class="text-[15px] font-semibold text-ink">{route.name}</span>
						{route.destination && (
							<div data-tina-field={tinaField(route, 'destination')} class="prose max-w-none text-[15px] leading-relaxed [--tw-prose-body:var(--color-body)]">
								<TinaMarkdown content={route.destination} components={mdxComponents} />
							</div>
						)}
					</div>
				))}
			</div>
		)}
		{data.note && (
			<div data-tina-field={tinaField(data, 'note')} class="prose mt-7 max-w-[68ch] text-sm leading-relaxed [--tw-prose-body:var(--color-muted-foreground)]">
				<TinaMarkdown content={data.note} components={mdxComponents} />
			</div>
		)}
	</div>
</section>
