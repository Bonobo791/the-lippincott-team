---
import { Image } from 'astro:assets';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import { safeHref, isExternal } from '../../lib/url';
import type { GuideHeroBlock } from '../../lib/data';

interface Props { data: Omit<GuideHeroBlock, '__typename'> }

const { data } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
const actions = (data.actions ?? []).flatMap((action) => {
	const href = safeHref(action?.link);
	return action && href ? [{ action, href }] : [];
});
---
{/* Stage hero: full-bleed photo on an ink band, bottom-left content, ghost
    chips. Without a backgroundImage it renders as a solid dark band. */}
<section class="relative flex min-h-[72svh] items-end overflow-hidden bg-tile text-white">
	{data.backgroundImage && (
		<div data-tina-field={tinaField(data, 'backgroundImage')} class="absolute inset-0">
			<Image src={data.backgroundImage} alt="" width={1920} height={1080} sizes="100vw" format="webp" quality={80} fetchpriority="high" loading="eager" decoding="async" class="size-full object-cover" />
		</div>
	)}
	<div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,rgba(23,21,26,.45)_0%,rgba(23,21,26,.15)_45%,rgba(23,21,26,.88)_100%)]"></div>
	<div class="relative mx-auto w-full max-w-[1200px] px-6 pb-14 pt-40 md:px-12 md:pb-20">
		{data.eyebrow && <p data-tina-field={tinaField(data, 'eyebrow')} class="eyebrow on-dark">{data.eyebrow}</p>}
		{data.title && (
			<div class="h2-mask mt-5">
				<SplitHeading as="h1" text={data.title} accentClass="font-normal italic text-gold" data-tina-field={tinaField(data, 'title')} class="max-w-[18ch] text-[clamp(2.4rem,5vw,4.2rem)] font-serif font-light leading-[1.06] tracking-[-0.02em] text-white" />
			</div>
		)}
		{chips.length > 0 && (
			<div class="mt-8 flex flex-wrap gap-3">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[13px] font-medium text-white backdrop-blur-sm">
						{chip.bold && <b class="font-semibold text-white">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
		{actions.length > 0 && (
			<div class="mt-10 flex flex-wrap items-center gap-4">
				{actions.map(({ action, href }) => (
					action.type === 'link' ? (
						<a
							href={href}
							data-tina-field={tinaField(action)}
							{...(isExternal(action.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							class="self-center border-b border-white/35 pb-0.5 text-sm font-semibold text-white/85 no-underline transition-colors duration-200 hover:border-white hover:text-white"
						>{action.label}</a>
					) : (
						<a
							href={href}
							data-tina-field={tinaField(action)}
							{...(isExternal(action.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							class="btn-magnetic inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 py-4 text-sm font-semibold text-white no-underline shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/90 active:scale-95"
						>{action.label} <span aria-hidden="true">→</span></a>
					)
				))}
			</div>
		)}
	</div>
</section>
{/* The short-answer capsule opens the paper band below the hero. */}
{data.answer && (
	<section class="bg-section pt-[clamp(40px,5vw,64px)]">
		<div class="mx-auto max-w-[1200px] px-6 md:px-12">
			<div data-tina-field={tinaField(data, 'answer')} class="max-w-[860px] rounded-2xl border border-border bg-background p-7 md:p-8">
				{data.answerLabel && <p data-tina-field={tinaField(data, 'answerLabel')} class="eyebrow mb-3.5">{data.answerLabel}</p>}
				<div class="prose max-w-[68ch] text-base [--tw-prose-body:var(--color-body)]">
					<TinaMarkdown content={data.answer} components={mdxComponents} />
				</div>
			</div>
		</div>
	</section>
)}
