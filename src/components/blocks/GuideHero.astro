---
import { Image } from 'astro:assets';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import GuideActions from '../ui/GuideActions.astro';
import type { GuideHeroBlock } from '../../lib/data';

interface Props {
	data: Omit<GuideHeroBlock, '__typename'>;
	/** Page-collection heroes (e.g. /about) stack the photo above the
	    headline at EVERY viewport, so overlay text never lands on faces. */
	stacked?: boolean;
}

const { data, stacked: stackProp = false } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
const stackedImage = data.mobileImage ?? data.backgroundImage;
const stacked = stackProp && stackedImage;
// Tina field bindings: the stacked variants edit `mobileImage` when one is
// set; the binding lives on the shared wrapper so the field never appears
// twice in the DOM (duplicate data-tina-field breaks visual editing).
const stackedTinaField = tinaField(data, data.mobileImage ? 'mobileImage' : 'backgroundImage');
---
{/* Stage hero: full-bleed photo on an ink band, bottom-left content, ghost
    chips. Without a backgroundImage it renders as a solid dark band. When
    `stacked` (page-collection heroes with a group photo, e.g. /about), the
    photo renders ABOVE the text at every viewport as a framed figure with
    a placard caption — the design system's `hero-stage--people` — so
    overlay text never lands on faces. One <Image> node for all viewports:
    it is the LCP at the top of the page, so it loads eager with
    fetchpriority="high" (same as the mock and the full-bleed variant). */}
<section class:list={["relative flex min-h-[72svh] items-end overflow-hidden bg-tile text-white", stacked && "min-h-0 flex-col items-stretch"]}>
	{stacked && stackedImage && (
		<div class="px-5 pt-6 md:px-12 md:pt-12">
			<figure data-tina-field={stackedTinaField} class="relative mx-auto max-w-[1200px]">
				<div class="rounded-2xl border border-white/15 bg-white/[.04] p-2 md:p-2.5">
					<Image src={stackedImage} alt="The Lippincott Team standing together on a lakeside path in Northwest Houston" width={1920} height={1280} sizes="(min-width: 1280px) 1152px, calc(100vw - 56px)" format="webp" quality={80} fetchpriority="high" decoding="async" class="max-h-[62svh] w-full rounded-xl object-cover object-[center_25%]" />
				</div>
				<figcaption class="absolute bottom-5 left-5 rounded-full border border-white/20 bg-[#100e13]/90 px-4 py-2 text-[9px] font-semibold uppercase tracking-[0.16em] text-white/75 backdrop-blur-sm md:bottom-7 md:left-7 md:text-[11px] md:tracking-[0.22em]">The Lippincott Team &middot; Northwest Houston</figcaption>
			</figure>
		</div>
	)}
	{!stacked && data.backgroundImage && (
		<div data-tina-field={tinaField(data, 'backgroundImage')} class="absolute inset-0">
			<Image src={data.backgroundImage} alt="" width={1920} height={1080} sizes="100vw" format="webp" quality={70} fetchpriority="high" loading="eager" decoding="async" class="size-full object-cover" />
		</div>
	)}
	{!stacked && (
		<div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,rgba(23,21,26,.45)_0%,rgba(23,21,26,.15)_45%,rgba(23,21,26,.88)_100%)]"></div>
	)}
	<div class:list={["relative mx-auto w-full max-w-[1200px] px-6 pb-14 pt-40 md:px-12 md:pb-20", stacked && "max-md:pt-10 md:pt-16"]}>
		{data.eyebrow && <p data-tina-field={tinaField(data, 'eyebrow')} class="eyebrow on-dark">{data.eyebrow}</p>}
		{data.title && (
			<div class="h2-mask mt-5">
				<SplitHeading as="h1" text={data.title} accentClass="font-normal italic text-gold" data-tina-field={tinaField(data, 'title')} class="max-w-[18ch] text-[clamp(2.4rem,5vw,4.2rem)] font-serif font-light leading-[1.12] tracking-[-0.02em] text-white" />
			</div>
		)}
		{chips.length > 0 && (
			<div class="mt-8 flex flex-wrap gap-3">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[13px] font-medium text-white backdrop-blur-sm">
						{chip.bold && <b class="font-semibold text-white">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
		<GuideActions actions={data.actions} class="mt-10" />
	</div>
</section>
