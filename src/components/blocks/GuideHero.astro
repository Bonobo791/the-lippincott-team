---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import type { GuideHeroBlock } from '../../lib/data';

interface Props { data: Omit<GuideHeroBlock, '__typename'> }

const { data } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
---
<section class="bg-section py-16 md:py-24">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{data.eyebrow && <p data-tina-field={tinaField(data, 'eyebrow')} class="eyebrow">{data.eyebrow}</p>}
		{data.title && (
			<div class="h2-mask mt-5">
				<SplitHeading as="h1" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[18ch] text-[clamp(2.4rem,5vw,4.2rem)] font-serif font-light leading-[1.06] tracking-[-0.02em] text-ink" />
			</div>
		)}
		{data.answer && (
			<div data-tina-field={tinaField(data, 'answer')} class="mt-8 max-w-[860px] rounded-2xl border border-border bg-background p-7 md:p-8">
				{data.answerLabel && <p data-tina-field={tinaField(data, 'answerLabel')} class="eyebrow mb-3.5">{data.answerLabel}</p>}
				<div class="prose max-w-[68ch] text-base [--tw-prose-body:var(--color-body)]">
					<TinaMarkdown content={data.answer} components={mdxComponents} />
				</div>
			</div>
		)}
		{chips.length > 0 && (
			<div class="mt-7 flex flex-wrap gap-3">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body">
						{chip.bold && <b class="font-semibold text-ink">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
	</div>
</section>
