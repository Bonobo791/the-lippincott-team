---
import { Image } from 'astro:assets';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import GuideActions from '../ui/GuideActions.astro';
import { safeHref, linkTargetAttrs } from '../../lib/url';
import type { GuideHeroBlock } from '../../lib/data';

interface Props {
	data: Omit<GuideHeroBlock, '__typename'>;
	/** Page-collection heroes (e.g. /about) split the photo beside the
	    headline at desktop widths (≥821px), so overlay text never lands on
	    faces. Below 821px they take the same Editorial Masthead anatomy as
	    every other guide hero. Only applies when the doc also sets
	    `mobileImage` — backgroundImage-only heroes render full-bleed. */
	stacked?: boolean;
}

const { data, stacked: stackProp = false } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
const stackedImage = data.mobileImage ?? data.backgroundImage;
// Only an explicit `mobileImage` opts a page-collection hero into the
// stacked split treatment; a backgroundImage alone means full-bleed.
const stacked = stackProp && data.mobileImage;
// Per-page focal point for the mobile 5:4 photo frame (Editorial Masthead).
const focalStyle = `--focal-x:${data.focalX ?? 50}%;--focal-y:${data.focalY ?? 42}%`;
// The mobile CTA row duplicates the actions below the stat strip (the
// desktop copy stays inside the panel). Same safeHref/linkTargetAttrs
// filtering as GuideActions, but NO tina bindings on the duplicate — duplicate
// data-tina-field attributes break visual editing.
const mobileActions = (data.actions ?? []).flatMap((action) => {
	if (!action) return [];
	const href = safeHref(action.link);
	if (!href) return [];
	return [{ action, href, linkAttrs: linkTargetAttrs(action.link) }];
});
// Tina field bindings: the stacked variants edit `mobileImage` when one is
// set; the binding lives on the shared wrapper so the field never appears
// twice in the DOM (duplicate data-tina-field breaks visual editing).
const stackedTinaField = tinaField(data, data.mobileImage ? 'mobileImage' : 'backgroundImage');
---
{/* Stage hero: full-bleed photo on an ink band, bottom-left content, ghost
    chips. Below 821px it becomes the Editorial Masthead: an ivory masthead
    where the headline leads, then the photograph in a framed 5:4 crop with
    per-page focal control and no scrim, then the chips grown up into the
    site's hairline stat strip, then the actions as a full-width CTA row.
    `stacked` page-collection heroes (e.g. /about) split text and a framed
    photo figure at ≥821px and take the same masthead anatomy below it.
    Desktop-only utilities use min-[821px]: (not md:) so the masthead owns
    the whole ≤820px range with no overlapping-breakpoint conflicts. One
    <Image> node per hero for all viewports: it is the LCP at the top of
    the page, so it loads eager with fetchpriority="high". */}
<section class:list={[
	"relative overflow-hidden bg-tile text-white",
	stacked
		? "flex flex-col max-[820px]:bg-section min-[821px]:grid min-[821px]:grid-cols-[5fr_7fr] min-[821px]:items-center min-[821px]:gap-16 min-[821px]:px-[max(3rem,calc((100vw-1400px)/2))] min-[821px]:py-24"
		: "flex min-h-[72svh] items-end max-[820px]:min-h-0 max-[820px]:flex-col max-[820px]:items-stretch max-[820px]:bg-section",
]}>
	{stacked && stackedImage && (
		<figure data-tina-field={stackedTinaField} style={focalStyle} class="border border-white/15 p-2.5 min-[821px]:order-2 min-[821px]:p-3 max-[820px]:relative max-[820px]:order-1 max-[820px]:aspect-[5/4] max-[820px]:w-full max-[820px]:overflow-hidden max-[820px]:border-0 max-[820px]:p-0">
			<Image src={stackedImage} alt="The Lippincott Team · Northwest Houston" width={1920} height={1280} sizes="(min-width: 1496px) 753px, (min-width: 821px) calc(58.333vw - 119px), 100vw" format="webp" quality={80} fetchpriority="high" loading="eager" decoding="async" class="kenburns masthead-img w-full object-cover object-[center_25%] max-[820px]:absolute max-[820px]:inset-0 max-[820px]:h-full" />
			<figcaption class="mt-2 text-[12px] text-white/55 min-[821px]:mt-2.5 max-[820px]:hidden">The Lippincott Team &middot; Northwest Houston</figcaption>
		</figure>
	)}
	{!stacked && data.backgroundImage && (
		<div data-tina-field={tinaField(data, 'backgroundImage')} style={focalStyle} class="absolute inset-0 max-[820px]:relative max-[820px]:inset-auto max-[820px]:order-1 max-[820px]:aspect-[5/4] max-[820px]:w-full max-[820px]:overflow-hidden">
			<Image src={data.backgroundImage} alt="" width={1920} height={1080} sizes="100vw" format="webp" quality={70} fetchpriority="high" loading="eager" decoding="async" class="kenburns masthead-img size-full object-cover max-[820px]:absolute max-[820px]:inset-0 max-[820px]:h-full" />
		</div>
	)}
	{!stacked && (
		<div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,rgba(23,21,26,.45)_0%,rgba(23,21,26,.15)_45%,rgba(23,21,26,.88)_100%)] max-[820px]:hidden"></div>
	)}
	<div class:list={[stacked ? "relative min-[821px]:order-1 max-[820px]:order-0 max-[820px]:max-w-[34rem] max-[820px]:px-[22px] max-[820px]:py-[34px]" : "relative mx-auto w-full max-w-[1200px] px-6 pb-14 pt-40 min-[821px]:px-12 min-[821px]:pb-20 max-[820px]:mx-0 max-[820px]:max-w-[34rem] max-[820px]:px-[22px] max-[820px]:pb-[34px] max-[820px]:pt-[34px]"]}>
		{data.eyebrow && <p data-tina-field={tinaField(data, 'eyebrow')} class="eyebrow on-dark masthead-eyebrow">{data.eyebrow}</p>}
		{data.title && (
			<div class="h2-mask mt-5 max-[820px]:mt-4">
				<SplitHeading as="h1" text={data.title} accentClass="font-normal italic text-gold max-[820px]:text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[18ch] text-[clamp(2.4rem,5vw,4.2rem)] font-serif font-light leading-[1.12] tracking-[-0.02em] text-white max-[820px]:max-w-[14ch] max-[820px]:text-[clamp(2.5rem,10vw,3.4rem)] max-[820px]:leading-[1.08] max-[820px]:text-ink" />
			</div>
		)}
		{chips.length > 0 && (
			<div class="mt-8 flex flex-wrap gap-3 max-[820px]:hidden">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[13px] font-medium text-white backdrop-blur-sm">
						{chip.bold && <b class="font-semibold text-white">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
		<GuideActions actions={data.actions} class="mt-10 max-[820px]:hidden" />
	</div>
	{/* Editorial Masthead stat strip: the desktop chips grown up into the
	    site's hairline tile language (no tina bindings — see frontmatter). */}
	{chips.length > 0 && (
		<div class="hidden max-[820px]:order-2 max-[820px]:grid max-[820px]:grid-cols-3 max-[820px]:gap-px max-[820px]:border-y max-[820px]:border-hairline max-[820px]:bg-hairline">
			{chips.map((chip) => (
				<div class="bg-section px-3 pb-5 pt-[18px]">
					{chip.bold && <div class="font-serif text-[clamp(1.3rem,5.6vw,1.7rem)] font-light leading-[1.05] text-ink">{chip.bold}</div>}
					{chip.label && <div class="mt-2 text-[10.5px] font-semibold uppercase leading-[1.45] tracking-[0.12em] text-[#6a6870]">{chip.label}</div>}
				</div>
			))}
		</div>
	)}
	{/* Editorial Masthead CTA row: one full-width red button (min-height
	    50px) under the strip for heroes that carry actions. */}
	{mobileActions.length > 0 && (
		<div class="hidden max-[820px]:order-3 max-[820px]:flex max-[820px]:flex-col max-[820px]:gap-3 max-[820px]:px-[22px] max-[820px]:py-6">
			{mobileActions.map(({ action, href, linkAttrs }) => (
				action.type === 'link' ? (
					<a href={href} {...linkAttrs} class="inline-flex min-h-[50px] items-center justify-center text-sm font-semibold text-ink"><span class="border-b border-[#17151a]/35 pb-0.5">{action.label}</span></a>
				) : (
					<a href={href} {...linkAttrs} class="inline-flex min-h-[50px] items-center justify-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 text-sm font-semibold text-white no-underline shadow-lg transition-colors duration-200 hover:bg-primary/90 active:scale-95">{action.label} <span aria-hidden="true">→</span></a>
				)
			))}
		</div>
	)}
</section>
<script is:inline>
	if (!window.__heroKenBurnsBound) {
		window.__heroKenBurnsBound = true;
		const initHeroKenBurns = () => {
			document.querySelectorAll('.kenburns').forEach((img) => {
				if (img.dataset.kb) return;
				img.dataset.kb = '1';
				// Always settle to visible: the blur-to-sharp + Ken Burns CSS
				// is itself gated on prefers-reduced-motion, so marking .is-in
				// unconditionally is a no-op under reduce and can never leave
				// the hero blank (failed loads included) or stuck hidden if
				// the user's motion preference changes after load.
				const show = () => img.classList.add('is-in');
				// `complete` is true both for images that finished loading and
				// for images that already failed before this script ran — only
				// attach listeners while the request is still pending.
				if (img.complete) show();
				else {
					img.addEventListener('load', show, { once: true });
					img.addEventListener('error', show, { once: true });
				}
			});
		};
		// astro:page-load fires on first load and after each ClientRouter swap.
		document.addEventListener('astro:page-load', initHeroKenBurns);
	}
</script>
<noscript><style>.kenburns{opacity:1 !important;filter:none !important;transform:none !important}</style></noscript>
<style>
	/* Editorial Masthead (≤820px): the eyebrow trades its gold on-dark
	   treatment for deep red on ivory (WCAG AAA 7.0:1, red tick). */
	@media (max-width: 820px) {
		.eyebrow.on-dark.masthead-eyebrow {
			color: #9e1e2c;
		}
		.eyebrow.on-dark.masthead-eyebrow::before {
			background: var(--color-primary);
		}
		/* 5:4 framed photograph: focal-controlled crop, nothing on the photo. */
		.masthead-img {
			object-position: var(--focal-x, 50%) var(--focal-y, 42%);
		}
	}

	/* Ken Burns settle + blur-to-sharp arrival for hero photography, as the
	   spec pattern defines it (static under reduced motion). */
	@media (prefers-reduced-motion: no-preference) {
		.kenburns {
			opacity: 0;
			filter: blur(14px) saturate(0.92);
			transform: scale(1.07);
			transition:
				opacity 0.5s ease,
				filter 1.1s ease,
				transform 7s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.kenburns.is-in {
			opacity: 1;
			filter: blur(0) saturate(1);
			transform: scale(1);
		}
	}
</style>
