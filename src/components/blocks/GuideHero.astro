---
import { Image } from 'astro:assets';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import GuideActions from '../ui/GuideActions.astro';
import type { GuideHeroBlock } from '../../lib/data';

interface Props { data: Omit<GuideHeroBlock, '__typename'>; stackOnMobile?: boolean }

const { data, stackOnMobile = false } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
const stacked = stackOnMobile && data.backgroundImage;
// Tina field bindings: the mobile card edits `mobileImage` when one is set;
// when it falls back to the background image, only one of the two elements
// may carry the `backgroundImage` binding (duplicate data-tina-field).
const mobileTinaField = tinaField(data, data.mobileImage ? 'mobileImage' : 'backgroundImage');
const desktopTinaField = stacked && !data.mobileImage ? undefined : tinaField(data, 'backgroundImage');
---
{/* Stage hero: full-bleed photo on an ink band, bottom-left content, ghost
    chips. Without a backgroundImage it renders as a solid dark band. When
    `stacked` (page-collection heroes with a group photo, e.g. /about), mobile
    shows the photo as a rounded card above the text instead of behind it, so
    overlay text never lands on faces. */}
<section class:list={["relative flex min-h-[72svh] items-end overflow-hidden bg-tile text-white", stacked && "max-md:min-h-0 max-md:flex-col max-md:items-stretch"]}>
	{stacked && (
		<div data-tina-field={mobileTinaField} class="px-5 pt-6 md:hidden">
			<Image src={(data.mobileImage ?? data.backgroundImage)!} alt="" width={800} height={600} sizes="100vw" format="webp" quality={75} fetchpriority="high" loading="eager" decoding="async" class="w-full rounded-2xl object-cover" />
		</div>
	)}
	{data.backgroundImage && (
		<div data-tina-field={desktopTinaField} class:list={["absolute inset-0", stacked && "max-md:hidden"]}>
			<Image src={data.backgroundImage} alt="" width={1920} height={1080} sizes="100vw" format="webp" quality={70} fetchpriority="high" loading="eager" decoding="async" class="size-full object-cover" />
		</div>
	)}
	<div aria-hidden="true" class:list={["absolute inset-0 bg-[linear-gradient(180deg,rgba(23,21,26,.45)_0%,rgba(23,21,26,.15)_45%,rgba(23,21,26,.88)_100%)]", stacked && "max-md:hidden"]}></div>
	<div class:list={["relative mx-auto w-full max-w-[1200px] px-6 pb-14 pt-40 md:px-12 md:pb-20", stacked && "max-md:pt-10"]}>
		{data.eyebrow && <p data-tina-field={tinaField(data, 'eyebrow')} class="eyebrow on-dark">{data.eyebrow}</p>}
		{data.title && (
			<div class="h2-mask mt-5">
				<SplitHeading as="h1" text={data.title} accentClass="font-normal italic text-gold" data-tina-field={tinaField(data, 'title')} class="max-w-[18ch] text-[clamp(2.4rem,5vw,4.2rem)] font-serif font-light leading-[1.12] tracking-[-0.02em] text-white" />
			</div>
		)}
		{chips.length > 0 && (
			<div class="mt-8 flex flex-wrap gap-3">
				{chips.map((chip) => (
					<span data-tina-field={tinaField(chip)} class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[13px] font-medium text-white backdrop-blur-sm">
						{chip.bold && <b class="font-semibold text-white">{chip.bold}</b>}
						{chip.label}
					</span>
				))}
			</div>
		)}
		<GuideActions actions={data.actions} class="mt-10" />
	</div>
</section>
