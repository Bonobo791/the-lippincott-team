---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import { hasRichText } from '../../lib/rich-text';
import type { StepsSplitBlock } from '../../lib/data';

interface Props { data: Omit<StepsSplitBlock, '__typename'> }

const { data } = Astro.props;
const steps = (data.steps ?? []).filter(s => s !== null);
---
{/* Ivory split band: heading + lede on the left, numbered steps on the
    right (bold step title + paragraph per step). */}
<section class="bg-section py-12 md:py-16">
	<div class="mx-auto grid max-w-[1200px] items-start gap-10 px-6 md:grid-cols-2 md:gap-16 md:px-12">
		<div>
			{data.title && (
				<div class="h2-mask">
					<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
				</div>
			)}
			{hasRichText(data.summary) && (
				<div data-tina-field={tinaField(data, 'summary')} class="prose mt-6 max-w-[56ch] [--tw-prose-body:var(--color-body)]">
					<TinaMarkdown content={data.summary} components={mdxComponents} />
				</div>
			)}
		</div>
		{steps.length > 0 && (
			<ol class="grid gap-7">
				{steps.map((step, index) => (
					<li data-tina-field={tinaField(step)} class="grid grid-cols-[auto_1fr] items-baseline gap-5">
						<span aria-hidden="true" class="font-serif text-[clamp(1.5rem,2vw,1.9rem)] font-light leading-none tracking-[-0.02em] text-primary">{String(index + 1).padStart(2, '0')}</span>
						<div>
							{step.bold && <b class="block font-semibold text-ink">{step.bold}</b>}
							{step.text && <p class="mt-1.5 text-[15px] leading-relaxed text-body">{step.text}</p>}
						</div>
					</li>
				))}
			</ol>
		)}
	</div>
</section>
