---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import { communityPath, listCommunities } from '../../lib/data';
import type { CommunityGridBlock } from '../../lib/data';

interface Props { data: CommunityGridBlock }

const { data } = Astro.props;
const prefix = data.prefix ?? 'northwest-houston-real-estate';
// Sierra property-search URLs recovered from the migrated community bodies
// (the "View … Listings" link near the top of each doc, copied verbatim —
// including waller-isd's, which points at a Tomball middle-school search in
// the source content). Cards for communities without one fall back to the
// internal community page.
const sierraLinks: Record<string, string> = {
	'northwest-houston-real-estate/cypress-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Cypress/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/cypress-tx-real-estate/bridgeland-real-estate': 'https://www.thelippincottteam.com/property-search/results/#subdiv_%2Fbridgeland%2F/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/hockley-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Hockley/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/katy-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Katy/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/magnolia-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Magnolia/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/tomball-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Tomball/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-real-estate/waller-tx-real-estate': 'https://www.thelippincottteam.com/property-search/results/#city_Waller/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-schools-real-estate/cypress-fairbanks-isd-real-estate': 'https://www.thelippincottteam.com/property-search/results/#elementaryschool_Cypress%20Springs%20Elementary%2CCypresswood%20Elementary%20School%20(Aldine)/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-schools-real-estate/katy-isd-real-estate': 'https://www.thelippincottteam.com/property-search/results/#sortby_price%20asc/middleschool_%2Fkaty%2F/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-schools-real-estate/tomball-isd-real-estate': 'https://www.thelippincottteam.com/property-search/results/#sortby_price%20asc/middleschool_%2Ftomball%2F/listtypeinclude_Residential/locationmatchtype_AnyOf/',
	'northwest-houston-schools-real-estate/waller-isd-real-estate': 'https://www.thelippincottteam.com/property-search/results/#sortby_price%20asc/middleschool_%2Ftomball%2F/listtypeinclude_Residential/locationmatchtype_AnyOf/',
};
// Direct children of the prefix (one level deep), sorted by title.
const entries = (await listCommunities())
	.map((node) => ({ node, path: communityPath(node) }))
	.filter(({ path }) => path.startsWith(`${prefix}/`) && path.slice(prefix.length + 1).split('/').length === 1)
	.sort((a, b) => (a.node.title ?? '').localeCompare(b.node.title ?? ''));
---
<Section>
	{data.title && <h2 data-tina-field={tinaField(data, 'title')} class="text-center text-3xl font-semibold tracking-tight">{data.title}</h2>}
	{data.description && <p data-tina-field={tinaField(data, 'description')} class="mx-auto mt-4 max-w-2xl text-center text-muted-foreground">{data.description}</p>}
	<div class="mt-10 grid gap-6 md:grid-cols-2">
		{entries.map(({ node, path }) => {
			const sierraUrl = sierraLinks[path] ?? null;
			return (
				<a
					href={sierraUrl ?? `/${path}/`}
					{...(sierraUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					class="group relative block overflow-hidden rounded-2xl shadow-[0_20px_45px_-12px_rgba(16,24,40,0.12)]"
				>
					{node.heroImage ? (
						<img src={node.heroImage} alt={node.title ?? ''} width={600} height={400} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-105" />
					) : (
						<div aria-hidden class="aspect-[16/9] w-full bg-section"></div>
					)}
					<div aria-hidden class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
					<div class="absolute inset-x-0 bottom-0 p-6">
						<h3 class="text-2xl font-bold text-white">{node.title}</h3>
						<p class="mt-1 text-sm uppercase tracking-[0.1em] text-white/80">View Listings</p>
					</div>
				</a>
			);
		})}
	</div>
</Section>
