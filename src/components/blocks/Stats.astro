---
import { tinaField } from '@tinacms/astro/tina-field';
import type { StatsBlock } from '../../lib/data';

interface Props { data: Omit<StatsBlock, '__typename'> }

const { data } = Astro.props;
const stats = (data.stats ?? []).filter(s => s !== null);
// Split editor strings like "$400M+" into prefix/number/suffix so the number
// can count up while the "$", "M" and red "+" stay static.
const parsed = stats.map((s) => {
	const m = (s.stat ?? '').match(/^([^\d]*)([\d,]+)(.*?)(\+?)$/);
	return {
		raw: s.stat ?? '',
		prefix: m?.[1] ?? '',
		target: m ? Number(m[2].replace(/,/g, '')) : null,
		comma: (m?.[2] ?? '').includes(','),
		suffix: m?.[3] ?? '',
		plus: m?.[4] ?? '',
	};
});
---
<section data-stats-section class="font-apple relative overflow-hidden bg-tile py-16 text-white md:py-24">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{data.title && <p data-tina-field={tinaField(data, 'title')} class="eyebrow on-dark relative">{data.title}</p>}
		{data.description && <p data-tina-field={tinaField(data, 'description')} class="relative mt-4 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-[#cccccc]">{data.description}</p>}
		<div class="relative mt-12 grid gap-8 md:mt-14 md:grid-cols-3 md:gap-16">
			{parsed.map((stat, i) => (
				<div data-tina-field={tinaField(stats[i])}>
					<div class="flex items-baseline whitespace-nowrap text-[clamp(3rem,6vw,4.8rem)] font-semibold leading-none tracking-[-0.03em]">
						{stat.target !== null ? (
							<span
								class="stat-count"
								data-target={stat.target}
								data-prefix={stat.prefix}
								data-suffix={stat.suffix}
								data-format={stat.comma ? 'comma' : undefined}
							>{stat.prefix}{stat.comma ? stat.target.toLocaleString('en-US') : stat.target}{stat.suffix}</span>
						) : (
							<span>{stat.raw}</span>
						)}
						{stat.plus && <em class="not-italic text-accent-on-dark">{stat.plus}</em>}
					</div>
					<p data-tina-field={tinaField(stats[i], 'type')} class="mt-3 text-sm text-[#cccccc]">{stats[i].type}</p>
				</div>
			))}
		</div>
	</div>
</section>
<style>
	[data-stats-section]::before {
		content: '';
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(-24deg, rgba(255, 255, 255, 0.024) 0 9px, transparent 9px 46px);
		pointer-events: none;
	}
</style>
<script is:inline>
	if (!window.__statsCountBound) {
		window.__statsCountBound = true;
		let reduced = false;
		let obs = null;
		const counted = new WeakSet();
		const countCancels = new Set();
		const animateCount = (el) => {
			if (counted.has(el)) return;
			counted.add(el);
			const target = parseInt(el.dataset.target, 10);
			const prefix = el.dataset.prefix || '';
			const suffix = el.dataset.suffix || '';
			const comma = el.dataset.format === 'comma';
			const render = (v) => { el.textContent = prefix + (comma ? v.toLocaleString('en-US') : v) + suffix; };
			if (reduced) { render(target); return; }
			let start = null;
			let raf = null;
			const dur = 1700;
			const cancel = () => {
				if (raf !== null) cancelAnimationFrame(raf);
				render(target);
			};
			const step = (ts) => {
				if (!countCancels.has(cancel)) return;
				if (start === null) start = ts;
				const p = Math.min((ts - start) / dur, 1);
				const eased = 1 - Math.pow(1 - p, 3);
				render(Math.round(target * eased));
				if (p < 1) raf = requestAnimationFrame(step);
				else countCancels.delete(cancel);
			};
			countCancels.add(cancel);
			raf = requestAnimationFrame(step);
		};
		const teardownStatsCount = () => {
			if (obs) { obs.disconnect(); obs = null; }
			countCancels.forEach((cancel) => cancel());
			countCancels.clear();
		};
		const initStatsCount = () => {
			// A Tina refresh can replace sections without a before-swap event.
			teardownStatsCount();
			reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);
			if (reduced) { document.querySelectorAll('.stat-count').forEach(animateCount); return; }
			obs = new IntersectionObserver((entries, observer) => {
				if (observer !== obs) return;
				entries.forEach((e) => {
					if (e.isIntersecting) {
						e.target.querySelectorAll('.stat-count').forEach(animateCount);
						observer.unobserve(e.target);
					}
				});
			}, { threshold: 0.3 });
			document.querySelectorAll('[data-stats-section]').forEach((s) => {
				obs.observe(s);
			});
		};
		// astro:page-load fires on first load and after each ClientRouter swap;
		// before-swap drops the observer tied to the outgoing DOM.
		document.addEventListener('astro:page-load', initStatsCount);
		document.addEventListener('astro:before-swap', teardownStatsCount);
	}
</script>
