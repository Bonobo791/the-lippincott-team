---
import { tinaField } from '@tinacms/astro/tina-field';
import SplitHeading from '../ui/SplitHeading.astro';
import FaqAccordion from '../ui/FaqAccordion.astro';
import { richTextToPlainText } from '../../lib/rich-text';
import type { FaqBlock } from '../../lib/data';

interface Props { data: Omit<FaqBlock, '__typename'> }

const { data } = Astro.props;
const items = (data.items ?? []).filter(i => i !== null);
const faqJsonLd = data.jsonld && items.length > 0
	? JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: items.map((item) => ({
			'@type': 'Question',
			name: item.question ?? '',
			acceptedAnswer: { '@type': 'Answer', text: richTextToPlainText(item.answer) },
		})),
	}).replace(/</g, '\\u003c')
	: null;
---
<section class="font-apple bg-section py-20 md:py-32">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{data.title && (
			<div class="h2-mask">
				<SplitHeading as="h2" text={data.title} accentClass="font-normal italic" data-tina-field={tinaField(data, 'title')} class="text-[clamp(1.9rem,3.2vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink" />
			</div>
		)}
		{data.description && <p data-tina-field={tinaField(data, 'description')} class="mt-4 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-body">{data.description}</p>}
		{items.length > 0 && (
			<div class="mt-10 max-w-[860px] md:mt-12">
				<FaqAccordion items={items} tinaFieldFor={(item) => tinaField(item)} />
			</div>
		)}
	</div>
</section>
{faqJsonLd && <script type="application/ld+json" is:inline set:html={faqJsonLd} />}
