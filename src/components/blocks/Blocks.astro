---
import { tinaField } from '@tinacms/astro/tina-field';
import Callout from './Callout.astro';
import CommunityGrid from './CommunityGrid.astro';
import ContactForm from './ContactForm.astro';
import Content from './Content.astro';
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import Features from './Features.astro';
import Hero from './Hero.astro';
import Split from './Split.astro';
import Stats from './Stats.astro';
import TeamGrid from './TeamGrid.astro';
import Testimonial from './Testimonial.astro';
import TrustStrip from './TrustStrip.astro';
import Video from './Video.astro';
import TestimonialShowcase from './TestimonialShowcase.astro';
import Awards from './Awards.astro';
import TeamBanner from './TeamBanner.astro';
import GuideHero from './GuideHero.astro';
import StatLedger from './StatLedger.astro';
import PriceLadder from './PriceLadder.astro';
import CalloutRail from './CalloutRail.astro';
import DataTable from './DataTable.astro';
import PhotoCardGrid from './PhotoCardGrid.astro';
import CategoryTiles from './CategoryTiles.astro';
import RouteLedger from './RouteLedger.astro';
import TradeOffs from './TradeOffs.astro';
import NotePanel from './NotePanel.astro';
import ProofStage from './ProofStage.astro';
import RelatedChips from './RelatedChips.astro';
import GuideCta from './GuideCta.astro';
import ChecklistSplit from './ChecklistSplit.astro';
import StepsSplit from './StepsSplit.astro';
import type { CmsPage, CmsCommunity } from '../../lib/data';

interface Props {
	data?: CmsPage | CmsCommunity | null;
}

const { data } = Astro.props;
const blocks = (data?.blocks ?? []).filter(b => b !== null);
---
{blocks.map((block) => {
	const rendered = (() => {
		// Tina namespaces block typenames per collection+field (PageBlocksHero
		// vs CommunityBlocksHero); the shared templates render identically, so
		// dispatch on the suffix. TS can't narrow the union on a computed
		// string, hence the per-case `as never` cast on the data prop.
		switch (block.__typename.replace(/^(Page|Community)Blocks/, '')) {
			case 'Callout': return <Callout data={block as never} />;
			case 'CommunityGrid': return <CommunityGrid data={block as never} />;
			case 'ContactForm': return <ContactForm data={block as never} />;
			case 'Content': return <Content data={block as never} />;
			case 'Cta': return <Cta data={block as never} />;
			case 'Faq': return <Faq data={block as never} />;
			case 'Features': return <Features data={block as never} />;
			case 'Hero': return <Hero data={block as never} />;
			case 'Split': return <Split data={block as never} />;
			case 'Stats': return <Stats data={block as never} />;
			case 'TeamGrid': return <TeamGrid data={block as never} />;
			case 'Testimonial': return <Testimonial data={block as never} />;
			case 'TrustStrip': return <TrustStrip data={block as never} />;
			case 'Video': return <Video data={block as never} />;
			case 'TestimonialShowcase': return <TestimonialShowcase data={block as never} />;
			case 'Awards': return <Awards data={block as never} />;
			case 'TeamBanner': return <TeamBanner data={block as never} />;
			case 'GuideHero': return <GuideHero data={block as never} stackOnMobile={block.__typename.startsWith('PageBlocks')} />;
			case 'StatLedger': return <StatLedger data={block as never} />;
			case 'PriceLadder': return <PriceLadder data={block as never} />;
			case 'CalloutRail': return <CalloutRail data={block as never} />;
			case 'DataTable': return <DataTable data={block as never} />;
			case 'PhotoCardGrid': return <PhotoCardGrid data={block as never} />;
			case 'CategoryTiles': return <CategoryTiles data={block as never} />;
			case 'RouteLedger': return <RouteLedger data={block as never} />;
			case 'TradeOffs': return <TradeOffs data={block as never} />;
			case 'NotePanel': return <NotePanel data={block as never} />;
			case 'ProofStage': return <ProofStage data={block as never} />;
			case 'RelatedChips': return <RelatedChips data={block as never} />;
			case 'GuideCta': return <GuideCta data={block as never} />;
			case 'ChecklistSplit': return <ChecklistSplit data={block as never} />;
			case 'StepsSplit': return <StepsSplit data={block as never} />;
		}
	})();
	return <div data-tina-field={tinaField(block)}>{rendered}</div>;
})}
