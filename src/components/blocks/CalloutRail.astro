---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import type { CalloutRailBlock } from '../../lib/data';

interface Props { data: Omit<CalloutRailBlock, '__typename'> }

const { data } = Astro.props;
const figures = (data.figures ?? []).filter(f => f !== null);
---
<section class="font-apple py-20 md:py-28">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		<div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-20">
			<div>
				{data.title && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink" />
					</div>
				)}
				{data.body && (
					<div data-tina-field={tinaField(data, 'body')} class="prose mt-6 max-w-[68ch] [--tw-prose-body:var(--color-body)]">
						<TinaMarkdown content={data.body} components={mdxComponents} />
					</div>
				)}
			</div>
			{figures.length > 0 && (
				<div class="grid content-start gap-4">
					{figures.map((stat) => (
						<div data-tina-field={tinaField(stat)} class="grid gap-2.5 rounded-2xl border border-border bg-section p-7 md:p-8">
							{stat.source && <span data-tina-field={tinaField(stat, 'source')} class="text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{stat.source}</span>}
							<span data-tina-field={tinaField(stat, 'figure')} class="text-[clamp(2.4rem,4vw,3.4rem)] font-semibold leading-none tracking-[-0.02em] text-ink">{stat.figure}</span>
							{stat.text && <p data-tina-field={tinaField(stat, 'text')} class="max-w-[60ch] text-sm text-muted-foreground">{stat.text}</p>}
						</div>
					))}
				</div>
			)}
		</div>
		{data.note && (
			<div data-tina-field={tinaField(data, 'note')} class="prose mt-7 max-w-[68ch] text-sm leading-relaxed [--tw-prose-body:var(--color-muted-foreground)]">
				<TinaMarkdown content={data.note} components={mdxComponents} />
			</div>
		)}
	</div>
</section>
