---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import type { PageBlock } from '../../lib/data';

// Type is a pure derivation from the Tina schema (see src/lib/data.ts
// conventions); kept local so the block pair is self-contained.
type TrustStripBlock = Extract<PageBlock, { __typename: 'PageBlocksTrustStrip' }>;

interface Props { data: Omit<TrustStripBlock, '__typename'> }

const { data } = Astro.props;
const items = (data.items ?? []).filter(i => i !== null);
const isExternal = (href?: string | null) => !!href && /^https?:\/\//.test(href);
const externalAttrs = (href?: string | null) =>
	isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<Section background="bg-section" class="py-12 md:py-16">
	<div class="mx-auto max-w-4xl space-y-10 text-center">
		{data.title && <SplitHeading as="h2" text={data.title} accentClass="font-bold" data-tina-field={tinaField(data, 'title')} class="text-2xl font-light lg:text-3xl" />}
		{items.length > 0 && (
			<div class="flex flex-col items-center justify-center gap-10 sm:flex-row sm:items-start sm:gap-20 lg:gap-28">
				{items.map((item) => {
					const inner = (
						<>
							{item.image
								? <img src={item.image} alt={item.imageAlt ?? ''} width="109" height="76" loading="lazy" decoding="async" class="mx-auto h-14 w-auto object-contain" />
								: item.wordmark
									? <span data-tina-field={tinaField(item, 'wordmark')} class="text-3xl font-extrabold tracking-tight text-[#0067b8]">{item.wordmark}</span>
									: null}
							{item.ratingImage && <img src={item.ratingImage} alt="" width="68" height="12" loading="lazy" decoding="async" class="mx-auto mt-2 h-3 w-auto object-contain" />}
							{item.rating && <p data-tina-field={tinaField(item, 'rating')} class="mt-2 text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">{item.rating}</p>}
							{item.caption && <p data-tina-field={tinaField(item, 'caption')} class="mx-auto mt-3 max-w-xs text-sm italic text-muted-foreground">{item.caption}</p>}
						</>
					);
					return item.link ? (
						<a data-tina-field={tinaField(item)} href={item.link} {...externalAttrs(item.link)} class="block">
							{inner}
						</a>
					) : (
						<div data-tina-field={tinaField(item)}>
							{inner}
						</div>
					);
				})}
			</div>
		)}
	</div>
</Section>
