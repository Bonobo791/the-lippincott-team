---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import YouTubeFacade from '../ui/YouTubeFacade.astro';
import type { VideoBlock } from '../../lib/data';

interface Props { data: VideoBlock }

const { data } = Astro.props;

function parse(url = '') {
	const yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]+)/);
	if (yt) return { type: 'youtube' as const, id: yt[1] };
	const vimeo = url.match(/vimeo\.com\/(\d+)/);
	if (vimeo) return { type: 'embed' as const, src: `https://player.vimeo.com/video/${vimeo[1]}` };
	// Self-hosted (or otherwise directly playable) media files render as a
	// native <video> element instead of an iframe.
	if (/\.(mp4|webm|mov|m4v)(?:[?#]|$)/i.test(url)) return { type: 'file' as const, src: url };
	return url ? { type: 'embed' as const, src: url } : null;
}
const video = data.url ? parse(data.url) : null;

// YouTube plays via a click-to-load facade. `loop` needs `playlist=<id>` to work.
let ytParams = '';
if (video?.type === 'youtube' && data.loop) {
	ytParams = `&loop=1&playlist=${video.id}`;
}

// Non-YouTube embeds keep the lazy iframe with their autoplay/loop params.
let embedSrc: string | null = null;
if (video?.type === 'embed') {
	const params = new URLSearchParams();
	if (data.autoPlay) { params.set('autoplay', '1'); params.set('mute', '1'); }
	if (data.loop) params.set('loop', '1');
	const qs = params.toString();
	embedSrc = qs ? `${video.src}?${qs}` : video.src;
}

// Native <video> sources. MP4s get a same-path .webm sibling listed second:
// browsers that can't decode H.264 (e.g. codec-free Firefox builds) skip the
// MP4 by its type attribute — without a network request — and fall back to
// the WebM.
const FILE_MIME: Record<string, string> = { mp4: 'video/mp4', m4v: 'video/mp4', mov: 'video/mp4', webm: 'video/webm' };
let fileSources: { src: string; type: string }[] = [];
if (video?.type === 'file') {
	const ext = video.src.match(/\.(mp4|webm|mov|m4v)(?:[?#]|$)/i)?.[1]?.toLowerCase() ?? 'mp4';
	fileSources.push({ src: video.src, type: FILE_MIME[ext] });
	if (ext === 'mp4') fileSources.push({ src: video.src.replace(/\.mp4([?#]|$)/i, '.webm$1'), type: 'video/webm' });
}
---
{video && (
	<Section>
		<div data-tina-field={tinaField(data, 'url')} class="relative mx-auto aspect-video w-full max-w-5xl overflow-hidden rounded-2xl border">
			{video.type === 'youtube'
				? <YouTubeFacade id={video.id} params={ytParams} />
				: video.type === 'file'
					? <video class="absolute inset-0 h-full w-full object-cover" poster={data.poster || undefined} controls muted={data.autoPlay || undefined} autoplay={data.autoPlay || undefined} loop={data.loop || undefined} playsinline preload={data.autoPlay ? 'metadata' : 'none'}>{fileSources.map(s => <source src={s.src} type={s.type} />)}</video>
					: <iframe class="absolute inset-0 h-full w-full" src={embedSrc} title="Video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>}
		</div>
	</Section>
)}
