---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import type { CategoryTilesBlock } from '../../lib/data';

interface Props { data: Omit<CategoryTilesBlock, '__typename'> }

const { data } = Astro.props;
const tiles = (data.tiles ?? []).filter(t => t !== null);
const cols = tiles.length >= 3 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2';
---
<section class="py-20 md:py-28">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{(data.title || data.summary) && (
			<div class="mb-10 grid gap-4 md:mb-14">
				{data.title && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
					</div>
				)}
				{data.summary && (
					<div data-tina-field={tinaField(data, 'summary')} class="prose max-w-[56ch] text-[clamp(17px,1.6vw,21px)] [--tw-prose-body:var(--color-body)]">
						<TinaMarkdown content={data.summary} components={mdxComponents} />
					</div>
				)}
			</div>
		)}
		{tiles.length > 0 && (
			<div class={`grid gap-px border border-border bg-border ${cols}`}>
				{tiles.map((tile) => {
					const items = (tile.items ?? []).filter(i => i !== null);
					return (
						<div data-tina-field={tinaField(tile)} class="relative bg-background p-8 transition-colors duration-300 before:absolute before:left-0 before:top-0 before:h-0.5 before:w-full before:origin-left before:scale-x-[.15] before:bg-primary before:transition-transform before:duration-500 hover:bg-section hover:before:scale-x-100 md:p-10">
							<span class="mb-4 block text-xs font-semibold uppercase tracking-[0.18em] text-primary">{tile.label}</span>
							{items.length > 0 && (
								<ul class="grid gap-2.5">
									{items.map((item) => (
										<li data-tina-field={tinaField(item)} class="relative pl-6 text-[14.5px] leading-relaxed text-body before:absolute before:left-0 before:top-[0.68em] before:h-px before:w-3 before:bg-primary">{item.text}</li>
									))}
								</ul>
							)}
						</div>
					);
				})}
			</div>
		)}
		{data.note && (
			<div data-tina-field={tinaField(data, 'note')} class="prose mt-7 max-w-[68ch] text-sm leading-relaxed [--tw-prose-body:var(--color-muted-foreground)]">
				<TinaMarkdown content={data.note} components={mdxComponents} />
			</div>
		)}
	</div>
</section>
