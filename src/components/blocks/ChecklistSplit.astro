---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { mdxComponents } from '../mdx/components';
import { hasRichText } from '../../lib/rich-text';
import type { ChecklistSplitBlock } from '../../lib/data';

interface Props { data: Omit<ChecklistSplitBlock, '__typename'> }

const { data } = Astro.props;
const items = (data.checks ?? []).filter(i => i !== null);
---
{/* Ivory split band: heading + prose on the left, red-tick checklist on the
    right (bold lead-in + plain text per item). */}
<section class="bg-section py-12 md:py-16">
	<div class="mx-auto grid max-w-[1200px] items-center gap-10 px-6 md:grid-cols-2 md:gap-16 md:px-12">
		<div>
			{data.title && (
				<div class="h2-mask">
					<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
				</div>
			)}
			{hasRichText(data.body) && (
				<div data-tina-field={tinaField(data, 'body')} class="prose mt-6 max-w-[56ch] [--tw-prose-body:var(--color-body)]">
					<TinaMarkdown content={data.body} components={mdxComponents} />
				</div>
			)}
		</div>
		{items.length > 0 && (
			<ul class="grid gap-4">
				{items.map((item) => (
					<li data-tina-field={tinaField(item)} class="relative pl-8 text-[15px] leading-relaxed text-body before:absolute before:left-0 before:font-semibold before:text-primary before:content-['✓']">
						{item.bold && <b class="font-semibold text-ink">{item.bold}</b>}{' '}{item.text}
					</li>
				))}
			</ul>
		)}
	</div>
</section>
