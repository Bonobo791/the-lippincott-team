---
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { safeHref, isExternal } from '../../lib/url';
import type { RelatedChipsBlock } from '../../lib/data';

interface Props { data: Omit<RelatedChipsBlock, '__typename'> }

const { data } = Astro.props;
const chips = (data.chips ?? []).filter(c => c !== null);
---
<section class="font-apple bg-section py-14 md:py-20">
	<div class="mx-auto max-w-[1200px] px-6 md:px-12">
		{data.title && (
			<div class="h2-mask mb-8">
				<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink" />
			</div>
		)}
		{chips.length > 0 && (
			<div class="flex flex-wrap gap-3">
				{chips.map((chip) => (
					<a
						href={safeHref(chip.link) ?? '#'}
						data-tina-field={tinaField(chip)}
						{...(isExternal(chip.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body no-underline transition-colors duration-200 hover:border-primary hover:text-primary"
					>{chip.label}</a>
				))}
			</div>
		)}
	</div>
</section>
