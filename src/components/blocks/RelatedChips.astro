---
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { safeHref, isExternal } from '../../lib/url';
import type { RelatedChipsBlock } from '../../lib/data';

interface Props {
	data: Omit<RelatedChipsBlock, '__typename'>;
	/** Prominent surface: a binding-free duplicate of the block's chips
	    rendered right under the hero on community guides (duplicate
	    data-tina-field attributes break visual editing, so the tina
	    bindings stay on the bottom copy — same pattern as GuideHero's
	    mobile CTA row). */
	prominent?: boolean;
}

const { data, prominent = false } = Astro.props;
const chips = (data.chips ?? []).flatMap((chip) => {
	const href = safeHref(chip?.link);
	return chip && href ? [{ chip, href }] : [];
});
const externalAttrs = (link: string | undefined | null) =>
	isExternal(link) ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
{prominent ? (
	<section class="bg-section py-12 md:py-16">
		<div class="mx-auto max-w-[1200px] px-6 md:px-12">
			<div class="mb-7 flex flex-col gap-3">
				<p class="eyebrow">Community guides</p>
				{data.title && (
					<div class="h2-mask">
						<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
					</div>
				)}
			</div>
			{chips.length > 0 && (
				<div class="flex flex-wrap gap-3">
					{chips.map(({ chip, href }) => (
						<a
							href={href}
							{...externalAttrs(chip.link)}
							class="group inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-white no-underline transition-colors duration-200 hover:bg-primary"
						>
							{chip.label}
							<span aria-hidden="true" class="inline-block text-white/60 transition-transform duration-200 group-hover:translate-x-0.5">→</span>
						</a>
					))}
				</div>
			)}
		</div>
	</section>
) : (
	<section class="bg-section py-14 md:py-20">
		<div class="mx-auto max-w-[1200px] px-6 md:px-12">
			{data.title && (
				<div class="h2-mask mb-8">
					<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, 'title')} class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
				</div>
			)}
			{chips.length > 0 && (
				<div class="flex flex-wrap gap-3">
					{chips.map(({ chip, href }) => (
						<a
							href={href}
							data-tina-field={tinaField(chip)}
							{...externalAttrs(chip.link)}
							class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body no-underline transition-colors duration-200 hover:border-primary hover:text-primary"
						>{chip.label}</a>
					))}
				</div>
			)}
		</div>
	</section>
)}
