---
import { safeHref, linkTargetAttrs } from '../../lib/url';

interface Props {
	label?: string | null;
	link?: string | null;
}

/**
 * Prominent "download the guide" band rendered right under the hero on
 * community pages that carry a guide document (Cypress/Tomball/Waller).
 * Binding-free duplicate of the guideCta download action — the tina
 * bindings stay on the bottom copy (duplicate data-tina-field attributes
 * break visual editing, same pattern as GuideHero's mobile CTA row).
 */
const { label, link } = Astro.props;
const href = safeHref(link);
---
{href && label && (
	<section class="bg-section py-12 md:py-16">
		<div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 md:px-12">
			<p class="eyebrow">Free community guide</p>
			<a
				href={href}
				{...linkTargetAttrs(link)}
				class="btn-magnetic inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 py-4 text-sm font-semibold text-white no-underline shadow-lg transition-colors duration-200 hover:bg-primary/90 active:scale-95"
			>
				{label} <span aria-hidden="true">→</span>
			</a>
		</div>
	</section>
)}
