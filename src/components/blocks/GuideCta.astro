---
import SplitHeading from '../ui/SplitHeading.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import { safeHref, isExternal } from '../../lib/url';
import type { GuideCtaBlock } from '../../lib/data';

interface Props { data: Omit<GuideCtaBlock, '__typename'> }

const { data } = Astro.props;
const actions = (data.actions ?? []).flatMap((action) => {
	const href = safeHref(action?.link);
	return action && href ? [{ action, href }] : [];
});
---
<section class="relative overflow-hidden bg-tile py-20 text-center text-white md:py-28" data-guide-cta>
	<div class="relative z-[2] mx-auto max-w-[1200px] px-6 md:px-12">
		{data.title && (
			<div class="h2-mask">
				<SplitHeading as="h2" text={data.title} accentClass="font-normal italic text-gold" data-tina-field={tinaField(data, 'title')} class="mx-auto max-w-[22ch] text-balance text-[clamp(2rem,3.8vw,3rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-white" />
			</div>
		)}
		{data.description && <p data-tina-field={tinaField(data, 'description')} class="mx-auto mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-white/85">{data.description}</p>}
		{actions.length > 0 && (
			<div class="mt-9 flex flex-wrap items-center justify-center gap-4">
				{actions.map(({ action, href }) => (
					action.type === 'link' ? (
						<a
							href={href}
							data-tina-field={tinaField(action)}
							{...(isExternal(action.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							class="self-center border-b border-white/35 pb-0.5 text-sm font-semibold text-white/85 no-underline transition-colors duration-200 hover:border-white hover:text-white"
						>{action.label}</a>
					) : (
						<a
							href={href}
							data-tina-field={tinaField(action)}
							{...(isExternal(action.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							class="btn-magnetic inline-flex items-center gap-2.5 whitespace-nowrap rounded-full bg-primary px-7 py-4 text-sm font-semibold text-white no-underline shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary/90 active:scale-95"
						>{action.label} <span aria-hidden="true">→</span></a>
					)
				))}
			</div>
		)}
	</div>
</section>
<style>
	[data-guide-cta]::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background: radial-gradient(55% 90% at 50% 115%, rgba(214, 50, 60, 0.2), transparent 70%);
		pointer-events: none;
	}
</style>
