---
import { Image } from 'astro:assets';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsTeam } from '../../lib/data';
import { listTeam } from '../../lib/data';
import { telHref } from '../../lib/url';
import { mdxComponents } from '../mdx/components';
import ProofStage from '../blocks/ProofStage.astro';
import GuideActions from '../ui/GuideActions.astro';
import SplitHeading from '../ui/SplitHeading.astro';

interface Props { data?: CmsTeam | null }

const { data } = Astro.props;
const nameParts = (data?.name ?? '').trim().split(/\s+/).filter(Boolean);
const firstName = nameParts[0] ?? '';
// H1: the optional `headline` field carries the full editorial headline with
// **…** around the italic accent; fallback is the two-tone name split.
const splitName = nameParts.length > 1
	? `**${firstName}** ${nameParts.slice(1).join(' ')}`
	: `**${firstName}**`;
const h1 = data?.headline?.trim() || splitName;

// Chips row: other roster members, featured first, capped at 3 (plus the two
// fixed chips below). Runs in both the page and the /tina-island render.
const currentFilename = data?._sys?.filename;
const teammates = (await listTeam())
	.filter((m) => m._sys.filename !== currentFilename)
	.sort((a, b) => Number(b.featured ?? false) - Number(a.featured ?? false))
	.slice(0, 3);

// JSON-LD ProfilePage/Person (design spec). Telephone needs +1 dialing digits.
const phoneDigits = (data?.phone ?? '').replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
const jsonLd = data && {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	mainEntity: {
		'@type': 'Person',
		name: data.name,
		...(data.role ? { jobTitle: data.role } : {}),
		worksFor: { '@type': 'Organization', name: 'The Lippincott Team at eXp Realty' },
		...(data.email ? { email: `mailto:${data.email}` } : {}),
		...(phoneDigits ? { telephone: `+1${phoneDigits}` } : {}),
		...(data.photo ? { image: new URL(data.photo, Astro.url).href } : {}),
		workLocation: 'Northwest Houston, TX',
	},
};
---
{data && (
	<>
		<section class="pt-10 md:pt-14">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-[13px] text-muted-foreground">
					<a href="/" class="no-underline transition-colors hover:text-primary">Home</a>
					<span aria-hidden="true">›</span>
					<a href="/about/" class="no-underline transition-colors hover:text-primary">About</a>
					<span aria-hidden="true">›</span>
					<span aria-current="page">{data.name}</span>
				</nav>
				<div class="mt-7">
					<p class="eyebrow">Meet your local expert</p>
					<div class="h2-mask mt-4">
						<SplitHeading as="h1" text={h1} accentClass="font-normal italic text-primary" data-tina-field={tinaField(data, data.headline?.trim() ? 'headline' : 'name')} class="max-w-[24ch] text-balance text-[clamp(2.2rem,4.5vw,3.5rem)] font-serif font-light leading-[1.12] tracking-[-0.02em] text-ink" />
					</div>
				</div>
			</div>
		</section>
		<section class="py-12 md:py-16">
			<div class="mx-auto grid max-w-[1200px] items-start gap-10 px-6 md:grid-cols-2 md:px-12 md:gap-16">
				{data.photo && (
					<Image src={data.photo} alt={`${data.name}${data.role ? `, ${data.role} with The Lippincott Team` : ' with The Lippincott Team'}`} width={640} height={800} sizes="(min-width: 1200px) 520px, (min-width: 768px) calc((100vw - 160px) / 2), calc(100vw - 48px)" format="webp" quality={75} data-tina-field={tinaField(data, 'photo')} class="aspect-[4/5] w-full rounded-2xl object-cover object-top" />
				)}
				{data.bio && (
					<div data-tina-field={tinaField(data, 'bio')} class="prose prose-lg max-w-none">
						<TinaMarkdown content={data.bio} components={mdxComponents} />
					</div>
				)}
			</div>
		</section>
		<section class="bg-section py-12 md:py-16">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<div class="h2-mask mb-10 md:mb-14">
					<SplitHeading as="h2" text={`Work with **${firstName} directly.**`} accentClass="font-normal italic text-primary" class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
				</div>
				<div class="grid gap-px border border-border bg-border md:grid-cols-2 lg:grid-cols-4">
					{data.phone && (
						<div class="relative bg-background p-8 transition-colors duration-300 before:absolute before:left-0 before:top-0 before:h-0.5 before:w-full before:origin-left before:scale-x-[.15] before:bg-primary before:transition-transform before:duration-500 hover:bg-section hover:before:scale-x-100 motion-reduce:before:scale-x-100 motion-reduce:before:transition-none">
							<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Direct line</span>
							<a href={telHref(data.phone)} data-tina-field={tinaField(data, 'phone')} class="mt-3 block font-serif text-[clamp(19px,1.9vw,24px)] font-light leading-snug tracking-[-0.01em] text-ink no-underline transition-colors hover:text-primary">{data.phone}</a>
						</div>
					)}
					{data.email && (
						<div class="relative bg-background p-8 transition-colors duration-300 before:absolute before:left-0 before:top-0 before:h-0.5 before:w-full before:origin-left before:scale-x-[.15] before:bg-primary before:transition-transform before:duration-500 hover:bg-section hover:before:scale-x-100 motion-reduce:before:scale-x-100 motion-reduce:before:transition-none">
							<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Email</span>
							<a href={`mailto:${data.email}`} data-tina-field={tinaField(data, 'email')} class="mt-3 block break-all font-serif text-[clamp(19px,1.9vw,24px)] font-light leading-snug tracking-[-0.01em] text-ink no-underline transition-colors hover:text-primary">{data.email}</a>
						</div>
					)}
					{data.role && (
						<div class="relative bg-background p-8 transition-colors duration-300 before:absolute before:left-0 before:top-0 before:h-0.5 before:w-full before:origin-left before:scale-x-[.15] before:bg-primary before:transition-transform before:duration-500 hover:bg-section hover:before:scale-x-100 motion-reduce:before:scale-x-100 motion-reduce:before:transition-none">
							<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Specialty</span>
							<span data-tina-field={tinaField(data, 'role')} class="mt-3 block font-serif text-[clamp(19px,1.9vw,24px)] font-light leading-snug tracking-[-0.01em] text-ink">{data.role}</span>
						</div>
					)}
					<div class="relative bg-background p-8 transition-colors duration-300 before:absolute before:left-0 before:top-0 before:h-0.5 before:w-full before:origin-left before:scale-x-[.15] before:bg-primary before:transition-transform before:duration-500 hover:bg-section hover:before:scale-x-100 motion-reduce:before:scale-x-100 motion-reduce:before:transition-none">
						<span class="block text-xs font-semibold uppercase tracking-[0.18em] text-muted-foreground">Based in</span>
						<span class="mt-3 block font-serif text-[clamp(19px,1.9vw,24px)] font-light leading-snug tracking-[-0.01em] text-ink">Northwest Houston, TX</span>
					</div>
				</div>
			</div>
		</section>
		<ProofStage data={{
			eyebrow: 'The record',
			title: 'The record behind **your agent.**',
			metrics: [
				{ __typename: 'PageBlocksProofStageMetrics', value: 1463, suffix: '+', label: 'Homes sold', source: 'Team sales records, Northwest Houston' },
				{ __typename: 'PageBlocksProofStageMetrics', value: 750, suffix: '+', label: 'Five-star reviews', source: 'Google and HAR.com, rated 4.9 on both' },
				{ __typename: 'PageBlocksProofStageMetrics', value: 9, suffix: '×', label: 'HBJ awards', source: 'Residential Real Estate Award, 2017-2025' },
			],
		}} />
		<section class="bg-section py-14 md:py-20">
			<div class="mx-auto max-w-[1200px] px-6 md:px-12">
				<div class="h2-mask mb-8">
					<SplitHeading as="h2" text="The rest of **the team.**" accentClass="font-normal italic text-primary" class="max-w-[22ch] text-[clamp(1.9rem,3.2vw,2.5rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-ink" />
				</div>
				<div class="flex flex-wrap gap-3">
					<a href="/about/#team" class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body no-underline transition-colors duration-200 hover:border-primary hover:text-primary">Full roster</a>
					{teammates.map((m) => (
						<a href={`/about/${m._sys.filename}/`} class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body no-underline transition-colors duration-200 hover:border-primary hover:text-primary">{m.name}</a>
					))}
					<a href="/northwest-houston-real-estate/" class="inline-flex items-center rounded-full border border-border bg-background px-4 py-2 text-[13px] font-medium text-body no-underline transition-colors duration-200 hover:border-primary hover:text-primary">Northwest Houston guide</a>
				</div>
			</div>
		</section>
		<section class="relative overflow-hidden bg-tile py-16 text-center text-white md:py-24" data-agent-cta>
			<div class="relative z-[2] mx-auto max-w-[1200px] px-6 md:px-12">
				<div class="h2-mask">
					<SplitHeading as="h2" text={`Talk to ${firstName} about **your next move.**`} accentClass="font-normal italic text-gold" class="mx-auto max-w-[22ch] text-balance text-[clamp(2rem,3.8vw,3rem)] font-serif font-light leading-[1.1] tracking-[-0.02em] text-white" />
				</div>
				<p class="mx-auto mt-5 max-w-[56ch] text-[clamp(17px,1.6vw,21px)] text-white/85">A consultation costs nothing and commits you to nothing. Reach {firstName} directly or book time with the team.</p>
				<GuideActions actions={[
					{ label: 'Schedule a Consultation', link: '/contact-us/', type: 'button' },
					...(data.email ? [{ label: `Email ${firstName}`, link: `mailto:${data.email}`, type: 'link' }] : []),
				]} class="mt-9 justify-center" />
			</div>
		</section>
		<style>
			[data-agent-cta]::after {
				content: '';
				position: absolute;
				inset: auto 0 0 0;
				height: 45%;
				background: radial-gradient(55% 90% at 50% 115%, rgba(214, 50, 60, 0.2), transparent 70%);
				pointer-events: none;
			}
		</style>
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</>
)}
