---
/**
 * Community-prose h3 override (registered only in CommunityBody's
 * TinaMarkdown map). Static FAQ questions are the h3s whose text ends in
 * "?" — they get the G3b-3 accordion-row visual language (left + glyph,
 * serif bold question, hairline top divider) without restructuring the
 * editor-owned markup. All other h3s render at prose defaults.
 */
import { Icon } from 'astro-icon/components';

const html = await Astro.slots.render('default');
const text = html.replace(/<[^>]*>/g, '').replace(/&amp;/g, '&').trim();
const isQuestion = text.endsWith('?');
---
{isQuestion ? (
	<h3 class="flex items-center gap-4 border-t border-[#E5E7EB] pt-6 font-serif text-lg font-bold text-foreground md:text-xl">
		<span class="flex size-6 shrink-0 items-center justify-center" aria-hidden="true">
			<Icon name="tabler:plus" class="size-6" />
		</span>
		<span set:html={html} />
	</h3>
) : (
	<h3 set:html={html} />
)}
