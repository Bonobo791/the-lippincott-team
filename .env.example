SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. GA4 measurement ID; defaults to the production ID (G-ZREVRSHYJB).
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Runtime secret for contact-form lead forwarding to Sierra (used by the
# /api/contact endpoint on every platform: Netlify, Coolify/Docker, local).
# Never commit its value or prefix it with PUBLIC_.
# On Coolify, uncheck "Build Variable" so it stays runtime-only.
# SIERRA_API_KEY=

# Optional. Comma-separated list of extra origins (scheme://host[:port])
# allowed to submit the contact form, besides SITE_URL and the platform URL
# envs. Use it when the site is also served from an origin no platform var
# expresses — e.g. a staging Bunny edge hostname (https://<zone>.b-cdn.net)
# or a www alias served without a redirect. The /api/contact endpoint
# rejects browser POSTs whose Origin is not allowlisted ("Cross-origin form
# submissions are not allowed.").
# CONTACT_ALLOWED_ORIGINS=https://coolify-lippincott-staging.b-cdn.net

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node

# Bunny CDN (optional). AccessKey from the Bunny dashboard (Account → API);
# the pull-zone ID is the number in the pull zone's URL. The cache-purge
# script (run automatically on Coolify container start, or manually via
# `node scripts/deploy/purge-bunny-cache.mjs`) uses these to purge the CDN
# cache after every deploy. BUNNY_API_KEY is a secret — never commit its
# value or prefix it with PUBLIC_; on Coolify keep its Build Variable off.
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE_ID=

# Optional. Shared secret authorizing the /api/bunny-purge webhook (per-page
# Bunny cache purges between deploys). Generate with `openssl rand -hex 32`;
# send it as an Authorization: Bearer header (preferred), an
# x-bunny-purge-token header, or a ?token= query parameter. Never commit the
# value; on Coolify keep its Build Variable off (runtime-only).
# BUNNY_PURGE_SECRET=
