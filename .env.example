SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. GA4 measurement ID; defaults to the production ID (G-ZREVRSHYJB).
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Runtime secret for contact-form lead forwarding to Sierra (used by the
# /api/contact endpoint on every platform: Netlify, Coolify/Docker, local).
# Never commit its value or prefix it with PUBLIC_.
# On Coolify, uncheck "Build Variable" so it stays runtime-only.
# SIERRA_API_KEY=

# Optional. Comma-separated list of extra origins (scheme://host[:port])
# allowed to submit the contact form, besides SITE_URL, the platform URL
# envs, and the hardcoded brand/localhost origins (https://thelippincottteam.com,
# https://www.thelippincottteam.com, the old https://lippincottteam.com /
# https://www.lippincottteam.com pair while that domain transitions over, and
# localhost:4321/4322). Use it when the
# site is also served from an origin no platform var expresses — e.g. a
# staging Bunny edge hostname (https://<zone>.b-cdn.net). The /api/contact
# endpoint rejects browser POSTs whose Origin is not allowlisted
# ("Cross-origin form submissions are not allowed.").
# CONTACT_ALLOWED_ORIGINS=https://coolify-lippincott-staging.b-cdn.net

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node

# Bunny CDN (optional). AccessKey from the Bunny dashboard (Account → API);
# the pull-zone ID is the number in the pull zone's URL. Deploy-time cache
# purges run from CI (.github/workflows/bunny-purge.yml) with these two set
# as GitHub repository secrets — the key never enters the application
# environment. The purge script (`node scripts/bunny-purge.mjs`) is a no-op
# without them; with them set, a failed purge logs loudly and exits non-zero.
# BUNNY_API_KEY=
# BUNNY_PULL_ZONE_ID=

# Direct origin the CI purge workflow polls for the deploy-commit marker
# (/__moderaty_commit.txt) before purging: the Coolify app domain the pull
# zone uses as its origin, WITHOUT the CDN. Falls back to SITE_URL.
# BUNNY_ORIGIN_URL=

# OPT-IN last resort: purge from the container entrypoint on hosts where CI
# cannot run (keeps the readiness-probe wait; off by default — do not enable
# alongside the CI workflow, which is the primary trigger).
# BUNNY_PURGE_ON_START=true

# Optional. Shared secret authorizing the /api/bunny-purge webhook (per-page
# Bunny cache purges between deploys). Generate with `openssl rand -hex 32`;
# send it as an Authorization: Bearer header (preferred), an
# x-bunny-purge-token header, or a ?token= query parameter. Never commit the
# value; on Coolify keep its Build Variable off (runtime-only).
# BUNNY_PURGE_SECRET=
