SITE_URL=https://example.com
PUBLIC_TINA_CLIENT_ID=*** #Grab from TinaCloud app.tina.io
TINA_TOKEN=*** #Grab from TinaCloud app.tina.io

# Optional. GA4 measurement ID; defaults to the production ID (G-ZREVRSHYJB).
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Runtime secret for contact-form lead forwarding to Sierra (used by the
# /api/contact endpoint on every platform: Netlify, Coolify/Docker, local).
# Never commit its value or prefix it with PUBLIC_.
# On Coolify, uncheck "Build Variable" so it stays runtime-only.
# SIERRA_API_KEY=

# Optional. Hosting platforms are auto-detected (Vercel, Cloudflare, Netlify → Node).
# Set this only to force an adapter for a local/manual deploy, e.g. `wrangler deploy`.
# DEPLOY_ADAPTER=cloudflare  # vercel | cloudflare | netlify | node
